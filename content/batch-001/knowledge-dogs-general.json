    "images": [],
    "sourceEvidence": {
      "file": "content/batch-001/sources/aspca-heat.html",
      "excerpt": "Give pets plenty of fresh, clean water when it’s hot or humid outdoors"
    }
  },
  {
    "id": "knowledge-096",
    "contentType": "knowledge",
    "title": "停车办事时，不把宠物独自留在车里",
    "text": "不要把宠物单独留在停放的汽车中，车内高温可能带来致命中暑风险。扁脸动物、老年动物、超重动物，以及患有心肺疾病的动物，还需要格外注意保持凉爽。开车带宠物出门时，提前把停车后的照看安排想清楚；行程里哪怕只是临时停靠，也不应让无人照看的车厢成为它等待的地方。",
    "topics": [
      "新手养宠",
      "养宠经验"
    ],
    "circleId": "circle-neighbors",
