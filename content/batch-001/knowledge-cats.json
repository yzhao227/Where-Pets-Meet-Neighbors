      "sourceEvidence": {
        "file": "content/batch-001/sources/aspca-cat-urine-marking-cats.html",
        "excerpt": "Cats who urine mark also use their litter boxes for voiding"
      }
    },
    {
      "id": "knowledge-048",
      "contentType": "knowledge",
      "title": "窗外的猫，也可能影响室内情绪",
      "text": "室内猫反复看到窗外其他猫，可能产生紧张和冲突感，并通过尿标记回应。ASPCA建议在确认相关情境后，尝试关闭相应门窗或拉上窗帘，减少持续刺激。先记录标记发生的位置与时间，并排查健康因素；不需要强迫两只猫面对面熟悉。",
      "topics": [
        "养宠经验"
      ],
      "circleId": "circle-cats",
      "editorId": "catalog-cat-behavior",
      "source": {
