        "reviewedAt": "2026-09-29"
      },
      "images": [],
      "sourceEvidence": {
        "file": "content/batch-001/sources/aspca-cat-grooming-tips.html",
        "excerpt": "use a fresh cotton ball for each eye"
      }
    },
    {
      "id": "knowledge-017",
      "contentType": "knowledge",
      "title": "耳部护理只处理看得见的外侧",
      "text": "观察猫耳时，可以留意可见的耳垢、异味、发红或分泌物。使用兽医建议的清洁用品时，轻轻清理看得到的耳部内侧即可，不要把工具探入耳道。ASPCA提醒，向里探查可能造成损伤或感染；发现异常后先检查原因，不要反复深挖清洁。",
      "topics": [
        "新手养宠",
        "养宠经验"
      ],
      "circleId": "circle-cats",
      "editorId": "catalog-cat-home",
      "source": {
        "title": "Cat Grooming Tips",
        "publisher": "ASPCA",
