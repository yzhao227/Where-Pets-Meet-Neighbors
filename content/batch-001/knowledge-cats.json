        "checkedAt": "2026-09-29"
      },
      "review": {
        "status": "approved",
        "reviewer": "有宠有邻内容整理",
        "reviewedAt": "2026-09-29"
      },
      "images": [],
      "sourceEvidence": {
        "file": "content/batch-001/sources/aspca-general-cat.html",
        "excerpt": "for both indoor and outdoor cats, an ID tag or an implanted microchip can help ensure that your cat is returned"
      }
    },
    {
      "id": "knowledge-006",
      "contentType": "knowledge",
      "title": "不要把家里的药直接给猫吃",
      "text": "猫不舒服时，不要自行使用未经兽医处方指导的药物。人的药箱里有什么，并不能说明它适合猫。ASPCA明确提醒，若怀疑动物吞下有毒物质，应联系兽医寻求帮助；面对意外，先取得针对猫和具体物质的专业指导，比凭经验试药更重要。",
      "topics": [
        "新手养宠",
        "养宠经验"
      ],
      "circleId": "circle-cats",
      "editorId": "catalog-cat-home",
      "source": {
        "title": "General Cat Care",
        "publisher": "ASPCA",
        "author": "ASPCA",
        "url": "https://www.aspca.org/pet-care/cat-care/general-cat-care",
        "checkedAt": "2026-09-29"
      },
      "review": {
        "status": "approved",
        "reviewer": "有宠有邻内容整理",
        "reviewedAt": "2026-09-29"
      },
      "images": [],
      "sourceEvidence": {
        "file": "content/batch-001/sources/aspca-general-cat.html",
        "excerpt": "Never give your cat medication that has not been prescribed by a veterinarian."
      }
    },
    {
      "id": "knowledge-007",
      "contentType": "knowledge",
      "title": "疫苗安排要结合这只猫的情况",
      "text": "安排猫咪疫苗时，不宜照搬另一只猫的时间表。ASPCA建议由兽医结合年龄和健康情况提出建议，日常也应安排定期检查；已经生病或受伤时则应及时就诊。把过去的接种与就诊资料整理好，能让这次讨论围绕这只猫的实际需要展开。",
      "topics": [
        "新手养宠",
        "养宠经验"
      ],
      "circleId": "circle-cats",
      "editorId": "catalog-cat-home",
      "source": {
        "title": "General Cat Care",
        "publisher": "ASPCA",
        "author": "ASPCA",
