    },
    {
      "id": "knowledge-038",
      "contentType": "knowledge",
      "title": "老年猫的新变化，先记录再判断",
      "text": "老年猫变得不爱探索、吃得少、梳理减少，或对熟悉的人和环境反应不同，都值得与过去的状态比较并记录。ASPCA提醒，不要简单归为年纪大了；疼痛、感官变化等健康问题也可能表现为行为改变。把具体变化交给兽医判断，而不是自行诊断认知衰退。",
      "topics": [
        "养宠经验"
      ],
      "circleId": "circle-cats",
      "editorId": "catalog-cat-behavior",
      "source": {
        "title": "Older Cats with Behavior Problems",
        "publisher": "ASPCA",
        "author": "ASPCA",
        "url": "https://www.aspca.org/pet-care/cat-care/common-cat-behavior-issues/older-cats-behavior-problems",
        "checkedAt": "2026-09-29"
      },
      "review": {
        "status": "approved",
