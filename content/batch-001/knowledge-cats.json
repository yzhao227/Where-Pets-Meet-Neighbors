      },
      "review": {
        "status": "approved",
        "reviewer": "有宠有邻内容整理",
        "reviewedAt": "2026-09-29"
      },
      "images": [],
      "sourceEvidence": {
        "file": "content/batch-001/sources/aspca-general-cat.html",
        "excerpt": "Your veterinarian will make recommendations based on your cat's age and health."
      }
    },
    {
      "id": "knowledge-008",
      "contentType": "knowledge",
      "title": "营养补充不是越多越好",
      "text": "已经使用完整、均衡主食的猫，一般不需要再自行叠加维生素或矿物质。ASPCA提醒，某些营养素补充过量可能造成中毒；确有缺乏或特殊疾病时，应由兽医判断。给猫买补充剂前，先带上当前主食和已在使用的产品清单，核对是否真的需要。",
      "topics": [
        "新手养宠",
        "养宠经验"
      ],
      "circleId": "circle-cats",
      "editorId": "catalog-cat-home",
      "source": {
        "title": "Cat Nutrition Tips",
        "publisher": "ASPCA",
        "author": "ASPCA",
