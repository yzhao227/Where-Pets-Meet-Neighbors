{
  "batchId": "batch-001",
  "items": [
    {
      "id": "knowledge-001",
      "contentType": "knowledge",
      "title": "先按年龄与状态选主食",
      "text": "给猫挑主食时，先核对产品适用的成长阶段，再结合年龄、活动量和健康状况决定喂法。幼猫与成年猫的需求不同，不能仅凭包装上的口味判断是否合适。ASPCA建议让兽医评估饮食安排，并选择营养均衡、含必需营养素的食物；零食或单一食材不能替代完整主食。",
      "topics": [
        "新手养宠",
        "养宠经验"
      ],
      "circleId": "circle-cats",
      "editorId": "catalog-cat-home",
      "source": {
