      "images": [],
      "sourceEvidence": {
        "file": "content/batch-001/sources/aspca-cat-destructive-scratching.html",
        "excerpt": "scratch on things to remove frayed, worn outer claws and expose new, sharper claws"
      }
    },
    {
      "id": "knowledge-022",
      "contentType": "knowledge",
      "title": "抓板材质和方向，让猫来选择",
      "text": "有的猫喜欢水平抓板，有的偏好竖直或斜面；纸板、木材和剑麻等不同表面，也可能得到不同反应。可以先提供几种选择，观察它真正愿意使用哪一种，再把相似的款式放到其他位置。选购时，依据猫的偏好比只看外观更有帮助。",
      "topics": [
        "养宠经验"
      ],
      "circleId": "circle-cats",
      "editorId": "catalog-cat-behavior",
      "source": {
