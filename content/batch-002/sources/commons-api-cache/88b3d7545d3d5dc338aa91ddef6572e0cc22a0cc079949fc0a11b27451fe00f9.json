all_Python_%28Python_regius%29_in_natural_habitat.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled", "thumbwidth": 640, "thumbheight": 853, "thumbattribs": {"src": "https://upload.wikimedia.org/wikipedia/commons/1/1f/Ball_Python_%28Python_regius%29_in_natural_habitat.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled", "decoding": "async", "loading": "lazy", "width": 640, "height": 853}, "url": "https://upload.wikimedia.org/wikipedia/commons/1/1f/Ball_Python_%28Python_regius%29_in_natural_habitat.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "descriptionurl": "https://commons.wikimedia.org/wiki/File:Ball_Python_(Python_regius)_in_natural_habitat.jpg", "descriptionshorturl": "https://commons.wikimedia.org/w/index.php?curid=194009339", "extmetadata": {"DateTime": {"value": "2026-06-16 19:07:26", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "Ball Python (Python regius) in natural habitat", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "Python regius|CC-Zero|Bidibidi Refugee Settlement|Self-published work|Snakes of Uganda|Images from Wiki Loves Earth 2026 in Uganda", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "A ball python (Python regius) photographed coiled on a forest floor in the Bidibidi Refugee Settlement, Yumbe District, Uganda, resting among dry grass, leaf litter, and soil. The specimen displays the species' characteristic dorsal patterning of dark brown to black scales interspersed with irregular yellowish-cream and olive blotches, providing excellent camouflage against the natural substrate. Ball pythons are non-venomous constrictors native to sub-Saharan Africa, commonly found in grasslands, shrublands, and open forests. The Bidibidi Refugee Settlement, located in northwestern Uganda near the South Sudan border, is home to diverse wildlife coexisting within one of the world's largest refugee settlements. This photograph was taken as part of a contribution to Wiki Loves Earth 2026, documenting Uganda's rich biodiversity and natural heritage.", "source": "commons-desc-page"}, "DateTimeOriginal": {"value": "2026-06-16", "source": "commons-desc-page"}, "Credit": {"value": "<span class=\"int-own-work\" lang=\"en\">Own work</span>", "source": "commons-desc-page"}, "Artist": {"value": "<a href=\"//commons.wikimedia.org/wiki/User:Oliversamson1\" class=\"mw-redirect\" title=\"User:Oliversamson1\">Oliversamson1</a>", "source": "commons-desc-page"}, "LicenseShortName": {"value": "CC0", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "Creative Commons Zero, Public Domain Dedication", "source": "commons-desc-page"}, "AttributionRequired": {"value": "false", "source": "commons-desc-page", "hidden": ""}, "LicenseUrl": {"value": "http://creativecommons.org/publicdomain/zero/1.0/deed.en", "source": "commons-desc-page"}, "Copyrighted": {"value": "True", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}, "License": {"value": "cc0", "source": "commons-templates", "hidden": ""}}, "mime": "image/jpeg"}]}, {"pageid": 194406656, "ns": 6, "title": "File:Ball python.jpg", "index": 5, "imagerepository": "local", "imageinfo": [{"size": 85638, "width": 1536, "height": 2048, "thumburl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4c/Ball_python.jpg/960px-Ball_python.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "thumbwidth": 640, "thumbheight": 853, "responsiveUrls": {"2": "https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4c/Ball_python.jpg/1280px-Ball_python.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"}, "thumbattribs": {"src