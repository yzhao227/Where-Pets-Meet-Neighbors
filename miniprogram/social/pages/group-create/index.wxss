.group-create-page{padding-bottom:calc(44rpx + env(safe-area-inset-bottom));}.intro{color:#6A717B;font-size:26rpx;margin:3rpx 0 31rpx;}.group-name-field{margin-bottom:35rpx;}.label{display:flex;justify-content:space-between;gap:20rpx;}.label>text{font-size:21rpx;font-weight:400;color:#858B92;}.input{background:#FFF;}
.member-heading{display:flex;justify-content:space-between;align-items:center;gap:18rpx;font-size:29rpx;font-weight:650;}.member-heading>view>text{font-size:23rpx;color:#858B92;margin-left:15rpx;font-weight:400;}.member-heading button{color:#B84735;font-size:25rpx;padding:8rpx 0;}.selection-help{color:#858B92;font-size:22rpx;line-height:1.8;margin:8rpx 0 17rpx;}
button.friend-option{display:flex;gap:18rpx;align-items:center;padding:24rpx 0;width:100%;text-align:left;border-bottom:1rpx solid #E9E5E1;}.person-avatar{width:80rpx;height:80rpx;flex-shrink:0;border-radius:50%;background:#EFE8E1;}.avatar-fallback{display:flex;align-items:center;justify-content:center;color:#A66B54;font-size:30rpx;}.person-name{min-width:0;flex:1;font-size:28rpx;font-weight:550;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.check-circle{width:40rpx;height:40rpx;border:2rpx solid #D9D4CF;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#FFF;flex-shrink:0;font-size:25rpx;}.selected .check-circle{border-color:#CC4A37;background:#CC4A37;}
.empty-friends{padding:36rpx 29rpx;background:#FFF;border:1rpx solid #E9E5E1;border-radius:22rpx;color:#7D828B;font-size:25rpx;line-height:1.8;margin-top:23rpx;}.empty-title{color:#4D545E;font-size:30rpx;font-weight:600;margin-bottom:8rpx;}.empty-friends .btn{margin-top:25rpx;}.create-button{margin-top:34rpx!important;}.create-error{margin-top:28rpx;font-size:25rpx;}.retry-help{font-size:23rpx;margin-top:10rpx;color:#94603D;}
