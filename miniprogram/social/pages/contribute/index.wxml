<view class="page contribution-page">
  <view class="submission-tabs"><button class="submission-tab {{tab === 'form' ? 'active' : ''}}" data-id="form" bindtap="selectTab" disabled="{{busy}}">填写推荐</button><button class="submission-tab {{tab === 'mine' ? 'active' : ''}}" data-id="mine" bindtap="selectTab" disabled="{{busy}}">我的推荐</button></view>
  <view class="intro-copy">推荐适合宠物出行的地点或活动。提交后由运营核实，审核通过后发布到「宠物出行」。</view>
  <view wx:if="{{mode === 'demo'}}" class="local-note">本机体验：推荐内容和审核结果仅保存在当前设备，不会发送给远程运营人员。</view>
  <view wx:if="{{notice}}" class="notice-box">{{notice}}</view>
  <view wx:if="{{tab === 'form'}}">
    <view class="form-section"><view class="form-section-title">推荐什么？</view><view class="type-options"><button class="type-option {{form.type === 'place' ? 'selected' : ''}}" data-id="place" bindtap="selectType" disabled="{{busy || attemptLocked}}">好去处</button><button class="type-option {{form.type === 'event' ? 'selected' : ''}}" data-id="event" bindtap="selectType" disabled="{{busy || attemptLocked}}">活动</button></view>
      <view class="field"><view class="label">{{form.type === 'event' ? '活动名称' : '地点名称'}}<text class="required">必填</text></view><input class="input" value="{{form.title}}" data-field="title" bindinput="input" maxlength="60" disabled="{{busy || attemptLocked}}" placeholder="2–60 个字，使用真实名称"/></view>
      <view class="field"><view class="label">公共场所地址<text class="required">必填</text></view><input class="input" value="{{form.address}}" data-field="address" bindinput="input" maxlength="200" disabled="{{busy || attemptLocked}}" placeholder="填写可核实的公共场所地址"/></view>
      <view class="form-row"><view class="field"><view class="label">城市<text class="required">必填</text></view><input class="input" value="{{form.city}}" data-field="city" bindinput="input" maxlength="40" disabled="{{busy || attemptLocked}}" placeholder="城市"/></view><view class="field"><view class="label">行政区</view><input class="input" value="{{form.district}}" data-field="district" bindinput="input" maxlength="40" disabled="{{busy || attemptLocked}}" placeholder="选填"/></view></view>
      <view class="field"><view class="label">片区 / 商圈</view><input class="input" value="{{form.area}}" data-field="area" bindinput="input" maxlength="40" disabled="{{busy || attemptLocked}}" placeholder="选填，方便了解位置"/></view>
      <view wx:if="{{form.type === 'event'}}" class="form-row"><view class="field"><view class="label">开始日期<text class="required">必填</text></view><picker mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="input" disabled="{{busy || attemptLocked}}"><view class="input picker-value {{!form.startDate ? 'placeholder' : ''}}">{{form.startDate || '选择日期'}}</view></picker></view><view class="field"><view class="label">结束日期<text class="required">必填</text></view><picker mode="date" value="{{form.endDate}}" data-field="endDate" bindchange="input" disabled="{{busy || attemptLocked}}"><view class="input picker-value {{!form.endDate ? 'placeholder' : ''}}">{{form.endDate || '选择日期'}}</view></picker></view></view>
      <view class="field"><view class="label">详细介绍<text class="required">必填</text></view><textarea class="textarea description-field" value="{{form.description}}" data-field="description" bindinput="input" maxlength="2000" disabled="{{busy || attemptLocked}}" placeholder="10–2000 个字，介绍值得推荐的理由、开放安排和参与方式"/><view class="field-hint">{{form.description.length}} / 2000</view></view>
    </view>
    <view class="form-section"><view class="form-section-title">出行前要了解的信息</view>
      <view class="field"><view class="label">携宠情况</view><picker range="{{policyChoices}}" range-key="name" value="{{form.policyIndex}}" bindchange="selectPolicy" disabled="{{busy || attemptLocked}}"><view class="input picker-value">{{policyChoices[form.policyIndex].name}}<text>⌄</text></view></picker></view>
      <view class="field"><view class="label">携宠说明<text wx:if="{{form.petPolicyStatus !== 'unknown'}}" class="required">必填</text></view><textarea class="textarea short-field" value="{{form.petPolicyText}}" data-field="petPolicyText" bindinput="input" maxlength="500" disabled="{{busy || attemptLocked}}" placeholder="说明宠物种类、牵绳 / 宠物包要求、可进入区域等；不确定可注明待核实"/></view>
      <view class="field"><view class="label">费用说明</view><input class="input" value="{{form.costText}}" data-field="costText" bindinput="input" maxlength="200" disabled="{{busy || attemptLocked}}" placeholder="选填；留空表示费用待核实"/></view>
      <view class="field"><view class="label">参考链接</view><input class="input" value="{{form.sourceUrl}}" data-field="sourceUrl" bindinput="input" maxlength="1000" disabled="{{busy || attemptLocked}}" placeholder="选填，完整 HTTPS 链接"/><view class="field-hint">提供公开信息来源，方便运营核实。</view></view>
    </view>
    <view wx:if="{{formError}}" class="error-box form-error"><text>{{formError}}</text><view wx:if="{{attemptLocked}}" class="retry-copy">填写内容已保留，重试会继续同一次提交。</view></view>
    <button class="btn btn-primary submit-button" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{attemptLocked ? '重试提交' : '提交审核'}}</button>
  </view>
  <view wx:else class="my-submissions">
    <view class="list-toolbar"><view class="list-title">推荐记录</view><picker range="{{statuses}}" range-key="name" value="{{statusIndex}}" bindchange="changeStatus" disabled="{{busy}}"><view class="status-picker">{{statuses[statusIndex].name}} ⌄</view></picker></view>
    <view wx:if="{{loading}}" class="loading">正在读取你的推荐…</view><view wx:elif="{{error}}" class="error-box"><text>{{error}}</text><button class="btn btn-secondary" bindtap="refresh">重新加载</button></view>
    <view wx:elif="{{!items.length}}" class="empty-card"><view class="empty-title">{{statusIndex === 0 ? '还没有推荐记录' : '这个状态下暂时没有推荐'}}</view><view>你提交的活动和地点，以及审核结果，都会保存在这里。</view></view>
    <view wx:else>
      <view wx:for="{{items}}" wx:key="id" class="submission-card">
        <view class="record-top"><text class="record-kind">{{item.typeText}}</text><text class="record-status status-{{item.status}}">{{item.statusText}}</text></view><view class="record-title">{{item.title}}</view><view class="record-address">{{item.city}} {{item.district}} {{item.area}} · {{item.address}}</view><view wx:if="{{item.type === 'event'}}" class="record-date">{{item.startDate}} 至 {{item.endDate}}</view><view wx:if="{{item.submittedText}}" class="record-time">提交于 {{item.submittedText}}</view>
        <view wx:if="{{item.reviewNote}}" class="review-note"><view>审核说明</view><text>{{item.reviewNote}}</text></view>
        <view wx:if="{{expandedId === item.id}}" class="record-details"><view class="details-copy">{{item.description}}</view><view class="detail-line">携宠情况：{{item.policyText}}</view><view wx:if="{{item.petPolicyText}}" class="details-copy">{{item.petPolicyText}}</view><view class="detail-line">费用：{{item.costText || '待核实'}}</view><button wx:if="{{item.sourceUrl}}" class="text-button" bindtap="copySource" data-id="{{item.id}}">复制参考链接</button></view>
        <view class="record-actions"><button class="text-button" bindtap="toggleDetails" data-id="{{item.id}}">{{expandedId === item.id ? '收起详情' : '查看详情'}}</button><button wx:if="{{item.status === 'pending'}}" class="text-button muted-action" bindtap="withdraw" data-id="{{item.id}}" disabled="{{busy}}">撤回</button><button wx:if="{{item.status === 'rejected' || item.status === 'withdrawn'}}" class="small-button" bindtap="copyDraft" data-id="{{item.id}}" disabled="{{busy}}">修改后重新提交</button><button wx:if="{{item.status === 'approved' && item.publishedId}}" class="small-button" bindtap="openPublished" data-id="{{item.id}}">查看已发布内容</button></view>
      </view>
    </view>
    <button wx:if="{{nextCursor && !loading && !error}}" class="btn btn-ghost" bindtap="loadMore" disabled="{{busy || moreBusy}}" loading="{{moreBusy}}">查看更多推荐</button>
  </view>
</view>
