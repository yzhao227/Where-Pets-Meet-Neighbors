.submissions-manage-page{padding-bottom:calc(44rpx + env(safe-area-inset-bottom));}.page-title{font-size:36rpx;}.local-note{padding:15rpx 18rpx;border-radius:14rpx;background:#EEF2F4;color:#657886;font-size:22rpx;line-height:1.7;margin-bottom:22rpx;}.notice-box{padding:18rpx 21rpx;margin:20rpx 0;background:#EDF3EE;color:#55735E;border-radius:15rpx;font-size:24rpx;line-height:1.7;}.intro-copy{font-size:25rpx;color:#6A717B;line-height:1.8;margin:18rpx 0 25rpx;}.list-toolbar{display:flex;justify-content:space-between;align-items:center;gap:18rpx;margin:16rpx 0;}.status-picker{font-size:24rpx;color:#6A717B;padding:7rpx 0 7rpx 15rpx;}.empty-card{padding:37rpx 28rpx;background:#FFF;border:1rpx solid #E9E5E1;border-radius:22rpx;font-size:25rpx;color:#7D828B;line-height:1.8;}.empty-title{font-size:29rpx;color:#4D545E;font-weight:600;margin-bottom:12rpx;}.submission-card{padding:25rpx!important;margin-bottom:22rpx!important;background:#FFF!important;border:1rpx solid #E9E5E1!important;border-radius:22rpx!important;}.record-button{width:100%!important;text-align:left!important;}.record-top{display:flex;align-items:center;justify-content:space-between;gap:16rpx;}.record-kind{font-size:21rpx;background:#F2EFEB;color:#7A756F;padding:3rpx 11rpx;border-radius:8rpx;}.record-status{font-size:22rpx;color:#8A9099;}.status-pending{color:#AA7145;}.status-approved{color:#5D8166;}.status-rejected{color:#B65D4B;}.record-title{font-size:30rpx;font-weight:650;line-height:1.6;margin:14rpx 0 8rpx;word-break:break-word;}.record-address,.record-date{font-size:23rpx;line-height:1.8;color:#767E88;word-break:break-word;}.record-bottom{display:flex;justify-content:space-between;gap:18rpx;font-size:21rpx;color:#9A9DA4;margin-top:17rpx;}.review-link{color:#B84735;flex-shrink:0;}.editor-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:20rpx;}.editor-title{font-size:35rpx;font-weight:650;}.text-button{font-size:24rpx!important;color:#B84735!important;padding:9rpx 0!important;}.review-note{background:#FAF0E6;padding:16rpx 18rpx;border-radius:13rpx;font-size:23rpx;line-height:1.8;margin-top:20rpx;color:#827160;}.review-note>view{font-weight:600;margin-bottom:4rpx;}.review-note>text{white-space:pre-wrap;word-break:break-word;}
.form-section{padding:26rpx 24rpx 5rpx;background:#FFF;border:1rpx solid #E9E5E1;border-radius:22rpx;margin-top:22rpx;}.form-section-title{font-size:29rpx;font-weight:650;margin-bottom:24rpx;}.type-options{display:flex;gap:14rpx;margin-bottom:27rpx;}.type-option{padding:13rpx 30rpx!important;font-size:26rpx!important;border:1rpx solid #E5E0DB!important;border-radius:15rpx!important;color:#747A82!important;background:#FAF8F5!important;}.type-option.selected{color:#B84735!important;background:#FFF0E9!important;border-color:#EDB7A7!important;}.field{margin-bottom:23rpx;}.label{font-size:25rpx;display:flex;gap:12rpx;align-items:center;margin-bottom:9rpx;}.required{font-weight:400;color:#A1A3A8;font-size:20rpx;}.input{height:83rpx;padding:18rpx;font-size:26rpx;background:#FAF9F7;}.form-row{display:flex;gap:18rpx;}.form-row>.field{flex:1;min-width:0;}.form-row .input{min-width:0;}.textarea{font-size:26rpx;padding:18rpx;line-height:1.75;}.description-field{height:270rpx;min-height:270rpx;}.short-field{height:174rpx;min-height:174rpx;}.picker-value{display:flex;align-items:center;justify-content:space-between;}.form-error{font-size:25rpx;line-height:1.7;margin:24rpx 0;}.retry-copy{font-size:23rpx;margin-top:8rpx;}.review-section{margin-top:30rpx;}.confirmation-row{display:flex;gap:12rpx;align-items:flex-start;margin-top:27rpx;font-size:24rpx;line-height:1.8;color:#626B76;}.confirmation-row>text{flex:1;min-width:0;}.review-checkbox{flex-shrink:0;transform:scale(.82);transform-origin:left top;}.decision-actions{display:flex;gap:16rpx;margin-top:26rpx;}.decision-actions>.btn{flex:1;min-width:0;padding-left:15rpx;padding-right:15rpx;}.decision-retry,.published-actions{margin-top:26rpx!important;}.published-actions{display:flex;flex-direction:column;gap:8rpx;}
