.library-note{padding:20rpx 24rpx;border-radius:18rpx;background:#f2f0e9;color:#697166;font-size:24rpx;line-height:1.8;margin-bottom:24rpx}.library-owner{font-size:28rpx;font-weight:600;margin-bottom:20rpx}.library-tabs{display:flex;gap:12rpx;margin-bottom:24rpx}button.library-tab{flex:1;padding:16rpx 10rpx;border-radius:18rpx;font-size:26rpx;background:#f0ede8;color:#747b79}button.library-tab.active{background:#406359;color:#fff}.library-empty{padding:40rpx 14rpx;color:#80877f;font-size:26rpx;line-height:1.9}button.library-row{display:block;width:100%;text-align:left;white-space:normal;margin-bottom:18rpx;padding:26rpx}.library-title{font-size:30rpx;font-weight:600;color:#35443e;word-break:break-all}.library-date{font-size:22rpx;color:#8a9089;margin-top:8rpx;line-height:1.7}.library-excerpt{font-size:26rpx;line-height:1.8;color:#68716c;margin-top:16rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-all}.library-text{display:block;white-space:pre-wrap;word-break:break-all;font-size:28rpx;line-height:1.9;margin:24rpx 0}.library-image{display:block;width:100%;margin-top:18rpx;border-radius:16rpx}button.library-back{text-align:left;font-size:25rpx;color:#406359;padding:0 0 22rpx;background:transparent}.library-pet{display:flex;align-items:center;gap:24rpx;margin-bottom:18rpx;font-size:26rpx;color:#68716c}.library-pet-photo{width:136rpx;height:136rpx;border-radius:24rpx;flex-shrink:0}
