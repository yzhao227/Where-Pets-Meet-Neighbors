page{height:100%;}.chat-page{height:100%;display:flex;flex-direction:column;min-height:0;}.chat-heading{display:flex;align-items:center;gap:20rpx;padding:20rpx 30rpx 18rpx;border-bottom:1rpx solid #E9E5E1;flex-shrink:0;}.chat-heading-copy{flex:1;min-width:0;}.chat-title{font-size:34rpx;font-weight:650;line-height:1.45;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.chat-subtitle{font-size:22rpx;color:#858B92;margin-top:4rpx;}button.members-button{padding:12rpx 0 12rpx 18rpx;color:#B84735;font-size:25rpx;}
.members-panel{padding:18rpx 28rpx 14rpx;border-bottom:1rpx solid #E9E5E1;flex-shrink:0;background:#FFF;}.members-scroll{max-height:240rpx;}.members-list{display:flex;flex-wrap:wrap;gap:16rpx 18rpx;}.member-card{width:112rpx;text-align:center;}.member-avatar{width:68rpx;height:68rpx;border-radius:50%;margin:auto;background:#EFE8E1;}.member-name{font-size:21rpx;margin-top:6rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}button.leave-button{font-size:23rpx;color:#B84735;padding:16rpx 0 2rpx;text-align:right;}
.local-note{flex-shrink:0;font-size:21rpx;color:#71808B;background:#EEF2F4;padding:9rpx 30rpx;}.sync-note{display:flex;gap:12rpx;justify-content:space-between;align-items:center;font-size:22rpx;background:#FFF3E6;color:#94603D;padding:12rpx 30rpx;flex-shrink:0;}.sync-note>text{flex:1;}.sync-note>button{color:#B84735;flex-shrink:0;padding:5rpx 0 5rpx 14rpx;}.error-box{margin:22rpx 30rpx;flex-shrink:0;}.loading{flex:1;}.chat-history{height:0;flex:1;min-height:160rpx;padding:0 26rpx;}.history-start,button.history-more{font-size:21rpx;color:#92969C;text-align:center;padding:24rpx 0 7rpx;}.chat-empty{text-align:center;padding:90rpx 22rpx;font-size:28rpx;color:#626973;}.chat-empty>text{display:block;font-size:24rpx;color:#92969C;margin-top:12rpx;}
.message-row{display:flex;gap:14rpx;align-items:flex-start;margin:27rpx 0;}.message-avatar{height:68rpx;width:68rpx;flex-shrink:0;border-radius:50%;background:#EFE8E1;}.avatar-fallback{display:flex;align-items:center;justify-content:center;color:#A66B54;font-size:26rpx;}.message-body{min-width:0;max-width:calc(100% - 110rpx);}.message-meta{font-size:19rpx;line-height:1.6;color:#8A9099;display:flex;gap:12rpx;flex-wrap:wrap;margin-bottom:7rpx;}.message-meta>text:first-child{max-width:270rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.message-bubble{display:inline-block;background:#FFF;border:1rpx solid #E9E5E1;border-radius:4rpx 20rpx 20rpx 20rpx;padding:15rpx 20rpx;font-size:28rpx;line-height:1.7;white-space:pre-wrap;word-break:break-word;overflow-wrap:anywhere;text-align:left;}.mine{flex-direction:row-reverse;}.mine .message-body{text-align:right;}.mine .message-meta{justify-content:flex-end;}.mine .message-bubble{background:#F8E0D5;border-color:#F0CEC0;border-radius:20rpx 4rpx 20rpx 20rpx;}.pending-row{padding-right:82rpx;}.pending-row .message-body{max-width:100%;}.send-failure{display:flex;gap:12rpx;justify-content:flex-end;align-items:center;margin-top:8rpx;color:#B84735;font-size:22rpx;}.send-failure>text{max-width:390rpx;}button.retry-send{flex-shrink:0;font-size:23rpx;text-decoration:underline;padding:5rpx;}.chat-bottom{height:20rpx;}
.chat-composer{flex-shrink:0;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:#FAF8F5;border-top:1rpx solid #E9E5E1;}.composer-row{display:flex;align-items:flex-end;gap:16rpx;}.chat-input{flex:1;min-width:0;min-height:78rpx;max-height:220rpx;background:#FFF;border:1rpx solid #E9E5E1;border-radius:18rpx;padding:17rpx 20rpx;font-size:27rpx;line-height:1.65;}.send-button{background:#CC4A37!important;color:#FFF!important;border-radius:16rpx!important;padding:16rpx 24rpx!important;font-size:26rpx!important;flex-shrink:0;min-height:78rpx;}.cannot-send{font-size:22rpx;color:#858B92;margin-bottom:13rpx;}
