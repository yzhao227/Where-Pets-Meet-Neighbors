.compose-page>.eyebrow{display:none;}
.compose-page{padding-top:30rpx;}
.page-title{font-size:40rpx;margin:0 0 10rpx;letter-spacing:0;}
.subtitle{font-size:24rpx;line-height:1.8;margin-bottom:14rpx;color:#77776F;}
.compose-page .demo-label{display:block;background:transparent;padding:0;color:#85857D;font-size:20rpx;margin-bottom:24rpx;}
.editor{padding:28rpx;background:#FFFEFC;border-color:#E9E6DE;border-radius:24rpx;}
.scope-picker{display:block;margin:0 4rpx 10rpx;}
.attachment-heading{font-size:23rpx;font-weight:500;color:#65695C;border-top:1rpx solid #EEEBE5;padding-top:24rpx;margin:22rpx 0 16rpx;}
.image-grid{display:flex;gap:12rpx;flex-wrap:wrap;}
.image-tile,button.upload-tile{flex:0 0 calc((100% - 24rpx)/3);width:calc((100% - 24rpx)/3);min-width:0;height:190rpx;border-radius:16rpx;overflow:hidden;position:relative;box-sizing:border-box;}
.image-tile{border:2rpx solid transparent;}
.image-tile.cover-selected{border-color:#858D70;}
.image-tile image{width:100%;height:100%;}
button.remove-image{position:absolute;right:5rpx;top:5rpx;height:44rpx;width:44rpx;display:flex;align-items:center;justify-content:center;line-height:1;padding:0;border-radius:50%;background:rgba(36,38,45,.65);color:#FFFFFF;font-size:28rpx;margin:0;}
button.set-cover{position:absolute;bottom:0;left:0;right:0;font-size:20rpx;line-height:2.1;color:#FFFFFF;background:rgba(36,38,45,.65);margin:0;border-radius:0;}
button.upload-tile{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;background:#F4F5EF;border:1rpx solid #E4E7DA;color:#676F57;font-size:23rpx;line-height:1.8;margin:0;padding:0;}
button.empty-upload{flex-basis:calc((100% - 12rpx)/2);width:calc((100% - 12rpx)/2);height:106rpx;flex-direction:row;gap:12rpx;border-radius:14rpx;}
button.empty-upload.single-upload{flex-basis:100%;width:100%;height:128rpx;}
.upload-plus{font-size:36rpx;line-height:1;font-weight:300;}
.photo-note{font-size:20rpx;color:#85857D;margin:14rpx 0 0;line-height:1.8;}
.title-input{display:block;height:76rpx;font-size:30rpx;line-height:1.5;font-weight:600;width:100%;box-sizing:border-box;padding:4rpx 0 18rpx;color:#33362E;border:0;border-bottom:1rpx solid #EEEBE5;border-radius:0;background:transparent;outline:none;box-shadow:none;}
.title-placeholder{color:#94978B;font-weight:500;}
.post-input{display:block;height:238rpx;width:100%;box-sizing:border-box;font-size:27rpx;line-height:1.9;padding:22rpx 0 0;color:#3D4037;border:0;border-radius:0;background:transparent;outline:none;box-shadow:none;resize:none;}
.body-placeholder{color:#A1A397;}
.title-input::placeholder{color:#94978B;font-weight:500;}
.post-input::placeholder{color:#A1A397;}
.counter{text-align:right;font-size:20rpx;color:#96988E;margin-top:12rpx;}
.visibility-option{display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-height:88rpx;padding:12rpx 0;}
.scope-label{font-size:23rpx;color:#77776F;}
.visibility-value{display:flex;align-items:center;gap:12rpx;color:#676D5F;font-size:23rpx;flex-shrink:0;}
.visibility-chevron{width:8rpx;height:8rpx;border-top:2rpx solid #949A8C;border-right:2rpx solid #949A8C;transform:rotate(45deg);}
.option-hint{font-size:21rpx;color:#747B85;font-weight:400;margin-left:9rpx;}
.posting-note{font-size:22rpx;line-height:1.8;color:#6A717B;margin:22rpx 4rpx;}
button.publish-button{width:100%;box-sizing:border-box;background:#697357;color:#FFFFFF;}
.compose-page .btn-ghost{color:#6B735D;}
.after-note{text-align:center;font-size:21rpx;color:#7B818A;margin-top:18rpx;line-height:1.8;}
.empty-symbol{font-size:60rpx;color:#EF725B;}
.empty-title{font-size:30rpx;font-weight:650;margin:20rpx 0 14rpx;color:#343741;}
.draft-error,.submit-error{font-size:23rpx;line-height:1.85;color:#94603D;background:#FFF3E6;border-radius:18rpx;padding:19rpx 22rpx;margin:20rpx 0;}
.upload-status-list{padding-top:16rpx;}
.upload-status{display:flex;align-items:center;gap:15rpx;padding:17rpx;background:#EAF2F8;border-radius:15rpx;margin-bottom:12rpx;}
.upload-status>view{flex:1;min-width:0;}
.upload-status-title{font-size:24rpx;color:#516B80;font-weight:500;}
.upload-status-copy{font-size:21rpx;color:#66707A;line-height:1.8;margin-top:6rpx;}
.upload-status.failed{background:#FFF3E6;}
.upload-status.failed .upload-status-title{color:#94603D;}
button.upload-remove{font-size:23rpx;padding:12rpx;color:#66707A;flex-shrink:0;}
button.check-uploads{font-size:24rpx;min-height:72rpx;padding:16rpx;margin:17rpx 0 10rpx;}
button.clear-draft{font-size:23rpx;margin-top:14rpx;}
.submit-error .btn,.draft-error .btn{font-size:23rpx;min-height:64rpx;padding:12rpx;}
button.remove-video{font-size:23rpx;color:#A65545;padding:16rpx 0 16rpx 20rpx;margin:0;}

.attachment-conflict{font-size:23rpx;line-height:1.8;color:#94603D;background:#FFF3E6;border:1rpx solid #F0D8B9;border-radius:16rpx;padding:18rpx 20rpx;margin-bottom:18rpx;}

.posting-options{padding:0 26rpx;margin-top:24rpx;border-color:#E9E6DE;border-radius:24rpx;overflow:hidden;}
.option-row,button.option-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;width:100%;min-height:92rpx;box-sizing:border-box;padding:22rpx 0;margin:0;border:0;border-bottom:1rpx solid #EFEEE8;border-radius:0;background:transparent;font-size:26rpx;line-height:1.6;text-align:left;font-weight:400;}
button.option-row::after,button.choice-chip::after,button.option-action::after{border:0;}
.option-name{flex-shrink:0;color:#41443B;}
.option-value{display:flex;align-items:center;justify-content:flex-end;gap:18rpx;flex:1;min-width:0;}
.option-summary{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:right;color:#A0A296;font-size:25rpx;}
.option-summary.has-value{color:#6E775F;}
.option-chevron{height:10rpx;width:10rpx;border-top:2rpx solid #A7AA9F;border-right:2rpx solid #A7AA9F;transform:rotate(45deg);flex:0 0 10rpx;margin-right:4rpx;}
.option-chevron.is-open{transform:rotate(135deg);margin-top:-5rpx;}
.option-panel{padding:4rpx 0 24rpx;border-bottom:1rpx solid #EFEEE8;}
.option-panel-hint{font-size:21rpx;color:#999D90;margin-bottom:16rpx;}
.animal-options,.topic-options{display:flex;flex-wrap:wrap;gap:10rpx;}
button.choice-chip{display:flex;align-items:center;justify-content:center;flex:0 0 calc((100% - 20rpx)/3);box-sizing:border-box;min-height:66rpx;line-height:1.5;font-size:24rpx;font-weight:400;padding:13rpx 7rpx;margin:0;color:#73776B;background:#F7F7F2;border:1rpx solid #EBEDE4;border-radius:12rpx;}
.topic-options button.choice-chip{flex-basis:calc((100% - 30rpx)/4);font-size:23rpx;}
button.choice-chip.selected{background:#EEF2E5;border-color:#BAC6A5;color:#53623E;}
.option-feedback{font-size:22rpx;line-height:1.8;color:#976847;margin:14rpx 0;}
.option-feedback-row{display:flex;align-items:center;justify-content:space-between;gap:12rpx;}
button.option-action{background:transparent;border:0;border-radius:0;margin:0;padding:10rpx 0;color:#717D5D;font-size:22rpx;line-height:1.7;text-align:left;}
button.option-action.option-feedback{margin:8rpx 0;}
