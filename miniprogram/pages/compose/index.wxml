<view class="page compose-page">
  <view class="page-title">{{personalMode ? '写一篇私人日记' : '记下这一刻'}}</view>
  <view class="subtitle">留住和宠物相伴的小事，也留住此刻的心情。</view>
  <view wx:if="{{loading}}" class="loading">正在打开记录本…</view>
  <view wx:elif="{{error}}" class="error-box"><text>{{error}}</text><button class="btn btn-secondary" bindtap="refresh">重新加载</button></view>
  <view wx:elif="{{!personalMode && circles.length === 0}}" class="empty"><view class="empty-symbol">🌱</view><view class="empty-title">选择一个记录去处</view><view class="muted">先加入一个感兴趣的圈子，再开始记录。</view><button class="btn btn-primary" bindtap="explore">选择圈子</button></view>
  <block wx:else>
  <view wx:if="{{personalMode || mode === 'demo'}}" class="demo-label">{{personalMode ? '仅自己可见 · 日记保存在当前设备' : '本机体验 · 记录仅保存在当前设备'}}</view>
  <view wx:if="{{draftError}}" class="draft-error">{{draftError}}<button class="btn btn-ghost" bindtap="saveDraft">重试保存草稿</button></view>
  <view class="editor card"><input class="title-input" value="{{title}}" bindinput="inputTitle" maxlength="40" placeholder="给今天起个标题（选填）" placeholder-class="title-placeholder" aria-label="记录标题，选填" disabled="{{busy}}"/><textarea class="post-input" value="{{text}}" bindinput="input" maxlength="1000" placeholder="今天的萌宠有什么新鲜事？快来记录吧" placeholder-class="body-placeholder" aria-label="记录正文" disabled="{{busy}}"/><view class="counter">{{text.length}} / 1000</view><block><view class="attachment-heading">照片<text class="option-hint">选填</text></view>
<view wx:if="{{hasVideoAttachment}}" class="attachment-conflict">此版本仅支持文字和图片。草稿中有不支持的旧附件，请移除后继续。
<button wx:if="{{video}}" class="remove-video" bindtap="removeVideo" disabled="{{busy || uploadsBusy}}">移除旧附件</button></view>
<view class="image-grid"><view wx:for="{{images}}" wx:key="*this" class="image-tile {{coverIndex === index ? 'cover-selected' : ''}}"><image wx:if="{{imagePreviewSources[index]}}" src="{{imagePreviewSources[index]}}" mode="aspectFill" bindtap="preview" data-index="{{index}}"/><view wx:else class="upload-status-copy">本机照片预览暂不可用，可移除后重新选择</view><button class="remove-image" catchtap="removeImage" data-index="{{index}}" disabled="{{busy}}">×</button><button class="set-cover" catchtap="chooseCover" data-index="{{index}}" disabled="{{busy}}">{{coverIndex === index ? '✓ 封面' : '设为封面'}}</button></view><button wx:if="{{!hasVideoAttachment && attachmentCount < 3}}" class="upload-tile {{attachmentCount === 0 ? 'empty-upload single-upload' : ''}}" bindtap="upload" loading="{{busy}}" disabled="{{busy || uploadsBusy}}"><text class="upload-plus">＋</text><text>添加照片</text></button></view><view wx:if="{{pendingUploads.length || failedUploads.length}}" class="upload-status-list"><view wx:for="{{pendingUploads}}" wx:key="ticketId" class="upload-status"><view><view class="upload-status-title">{{item.mediaType === 'video' ? '旧附件不再支持' : '◷ 等待图片处理'}}</view><view class="upload-status-copy">{{item.mediaType === 'video' ? '该附件不能发布，请移除后继续编辑文字和图片。' : item.message}}</view></view><button class="upload-remove" bindtap="removeUpload" data-id="{{item.ticketId}}" disabled="{{busy || uploadsBusy}}">移除</button></view><view wx:for="{{failedUploads}}" wx:key="ticketId" class="upload-status failed"><view><view class="upload-status-title">{{item.mediaType === 'video' ? '旧附件不再支持' : '图片处理未完成'}}</view><view class="upload-status-copy">{{item.mediaType === 'video' ? '该附件不能发布，请移除后继续编辑文字和图片。' : item.message}}</view></view><button class="upload-remove" bindtap="removeUpload" data-id="{{item.ticketId}}" disabled="{{busy || uploadsBusy}}">移除</button></view><button class="btn btn-secondary check-uploads" bindtap="retryUploads" loading="{{uploadsBusy}}" disabled="{{busy || uploadsBusy}}">重新检查与重试</button><view class="upload-status-copy">{{personalMode ? '附件只保存到本机，无法恢复的附件请移除后重选。' : mode === 'demo' ? '本机演示仅保存附件，不进行真实内容审核。无法恢复的附件请移除后重选。' : '审核通过后才能发布；未通过或已过期的附件请移除后重选。'}}</view></view><view wx:elif="{{uploadsBusy}}" class="upload-status-copy">正在恢复所选附件的处理状态…</view><view class="photo-note">最多添加 3 张照片，也可以只写文字</view></block></view><view class="posting-options card">
  <button class="option-row" bindtap="toggleAnimals" disabled="{{busy}}" aria-label="动物，{{animalSummary || '选填'}}" aria-expanded="{{animalsOpen}}">
    <text class="option-name">动物</text><view class="option-value"><text class="option-summary {{animalSummary ? 'has-value' : ''}}">{{animalSummary || '选填'}}</text><view class="option-chevron {{animalsOpen ? 'is-open' : ''}}" aria-hidden="true"></view></view>
  </button>
  <view wx:if="{{animalsOpen}}" class="option-panel">
    <view class="option-panel-hint">最多选 3 种</view>
    <view class="animal-options"><button wx:for="{{animalChoices}}" wx:key="id" class="choice-chip {{item.selected ? 'selected' : ''}}" bindtap="selectAnimal" data-id="{{item.id}}" disabled="{{busy}}" aria-label="{{item.name}}" aria-pressed="{{item.selected}}">{{item.shortName}}</button></view>
  </view>
  <block wx:if="{{!personalMode}}">
    <button class="option-row" bindtap="toggleTopics" disabled="{{busy}}" aria-label="标签，{{topicSummary || '选填'}}" aria-expanded="{{topicsOpen}}">
      <text class="option-name">标签</text><view class="option-value"><text class="option-summary {{topicSummary ? 'has-value' : ''}}">{{topicSummary || '选填'}}</text><view class="option-chevron {{topicsOpen ? 'is-open' : ''}}" aria-hidden="true"></view></view>
    </button>
    <view wx:if="{{topicsOpen}}" class="option-panel">
      <view class="option-panel-hint">最多选 3 个</view>
      <view class="topic-options"><button wx:for="{{topicChoices}}" wx:key="name" class="choice-chip {{item.selected ? 'selected' : ''}}" bindtap="selectTopic" data-topic="{{item.name}}" disabled="{{busy}}" aria-pressed="{{item.selected}}">{{item.name}}</button></view>
    </view>
    <picker range="{{circles}}" range-key="name" value="{{circleIndex}}" bindchange="chooseCircle" disabled="{{busy}}" aria-label="圈子，{{circles[circleIndex].name}}">
      <view class="option-row"><text class="option-name">圈子</text><view class="option-value"><text class="option-summary has-value">{{circles[circleIndex].name}}</text><view class="option-chevron" aria-hidden="true"></view></view></view>
    </picker>
  </block>
  <picker range="{{places}}" range-key="title" value="{{placeIndex}}" bindchange="choosePlace" disabled="{{busy}}" aria-label="公开地点，{{selectedPlaceId ? places[placeIndex].title : '不关联'}}">
    <view class="option-row"><text class="option-name">公开地点</text><view class="option-value"><text class="option-summary {{selectedPlaceId ? 'has-value' : ''}}">{{placeIndex ? places[placeIndex].title : selectedPlaceId ? '待确认' : '不关联'}}</text><view class="option-chevron" aria-hidden="true"></view></view></view>
  </picker>
  <view wx:if="{{selectedPlaceId && !placeIndex}}" class="option-feedback">原地点暂不可用，请重试或重新选择。</view>
  <view wx:if="{{selectedVisitId}}" class="option-feedback option-feedback-row"><text>已关联到访记录</text><button class="option-action" bindtap="clearVisit">取消关联</button></view>
  <view wx:if="{{pendingPlaceId}}" class="option-feedback">已保留原草稿地点。<button class="option-action" bindtap="applyRequestedPlace">使用刚才选择的地点</button></view>
  <button wx:if="{{placesError || placesBusy}}" class="option-action option-feedback" bindtap="loadPlaces" loading="{{placesBusy}}" disabled="{{placesBusy}}">{{placesError || '正在读取地点'}}</button>
  <block wx:if="{{!personalMode}}">
    <picker range="{{events}}" range-key="pickerLabel" value="{{eventIndex}}" bindchange="chooseEvent" disabled="{{busy}}" aria-label="活动，{{selectedEventId ? events[eventIndex].pickerLabel : '不关联'}}">
      <view class="option-row"><text class="option-name">活动</text><view class="option-value"><text class="option-summary {{selectedEventId ? 'has-value' : ''}}">{{eventIndex ? events[eventIndex].title : selectedEventId ? '待确认' : '不关联'}}</text><view class="option-chevron" aria-hidden="true"></view></view></view>
    </picker>
    <view wx:if="{{selectedEventId && !eventIndex}}" class="option-feedback">原活动尚未读取，请继续查找或重新选择。</view>
    <view wx:if="{{eventError}}" class="option-feedback">{{eventError}}</view>
    <button wx:if="{{eventsBusy || eventError || eventCursor}}" class="option-action option-feedback" bindtap="loadEvents" loading="{{eventsBusy}}" disabled="{{eventsBusy}}">{{eventError ? '重新读取活动' : '继续查找活动'}}</button>
  </block>
</view><view class="posting-note">{{personalMode ? '日记不会出现在发现页，也不会发送给其他用户。' : '记录中请勿包含住址、门牌或联系方式。'}}</view><view wx:if="{{submitError}}" class="submit-error">{{submitError}}<button wx:if="{{pendingUploads.length || failedUploads.length}}" class="btn btn-ghost" bindtap="retryUploads" disabled="{{busy || uploadsBusy}}">重试附件处理</button></view><!-- 暂停显示可见范围选择；新记录默认公开，历史草稿保留原范围。
<picker class="scope-picker" wx:if="{{!personalMode}}" range="{{visibilityChoices}}" range-key="name" value="{{visibilityIndex}}" bindchange="chooseVisibility" disabled="{{busy}}" aria-label="可见范围，当前{{visibilityChoices[visibilityIndex].name}}，{{visibilityChoices[visibilityIndex].hint}}"><view class="visibility-option"><text class="scope-label">可见范围</text><view class="visibility-value"><text>{{visibilityChoices[visibilityIndex].name}}</text><text class="visibility-chevron" aria-hidden="true"></text></view></view></picker>
--><button class="btn btn-primary publish-button" bindtap="submit" loading="{{busy}}" disabled="{{busy || uploadsBusy || hasVideoAttachment || pendingUploads.length || failedUploads.length}}">{{personalMode ? '保存私人日记' : visibility === 'private' ? '保存记录 · 仅自己可见' : visibility === 'friends' ? '发布记录 · 仅好友可见' : '发布记录'}}</button><view class="after-note">{{personalMode ? '草稿自动保存在本机。保存后可在「我的记录」查看或删除。' : '草稿自动保存在本机。记录提交后，可在详情中修改可见范围或删除。'}}</view><button class="btn btn-ghost clear-draft" bindtap="clearDraft" disabled="{{busy || uploadsBusy}}">清除本机草稿</button></block></view>
