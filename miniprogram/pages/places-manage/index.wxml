<view class="page"><view wx:if="{{loading}}" class="loading">正在读取管理信息…</view><view wx:elif="{{error}}" class="error-box">{{error}}<button class="btn btn-secondary" bindtap="refresh">重试</button></view><view wx:elif="{{!isAdmin}}" class="empty">此功能仅向运营者开放。</view><block wx:else>
  <view class="row between"><view class="page-title">地点与纠错</view><button class="btn btn-primary" bindtap="create">新增地点</button></view>
  <view class="row"><input class="input search" value="{{query}}" bindinput="query" bindconfirm="refresh" placeholder="搜地点名称或区域"/><button class="btn btn-secondary" bindtap="refresh">查找</button></view>
  <button class="btn btn-ghost" bindtap="publishCatalogue" disabled="{{busy}}">将随包目录补入服务端</button><view class="small muted">仅新增尚不存在的记录，不覆盖运营修改。云端需先创建地点相关数据集合。</view><view wx:if="{{published}}" class="small">{{published}}</view>
  <view wx:if="{{form}}" class="card manage-form"><view class="section-title">{{form.id ? '编辑地点' : '新增公开地点'}}</view>
    <input class="input" data-field="title" value="{{form.title}}" bindinput="input" placeholder="地点名称"/><input class="input" data-field="address" value="{{form.address}}" bindinput="input" placeholder="公共场所地址"/><view class="row"><input class="input" data-field="city" value="{{form.city}}" bindinput="input" placeholder="城市"/><input class="input" data-field="area" value="{{form.area}}" bindinput="input" placeholder="片区"/></view><textarea class="textarea" data-field="description" value="{{form.description}}" bindinput="input" maxlength="2000" placeholder="地点介绍"/>
    <input class="input" data-field="officialUrl" value="{{form.officialUrl}}" bindinput="input" placeholder="核实资料的 HTTPS 链接"/><picker range="{{policyChoices}}" range-key="name" value="{{form.policyIndex}}" bindchange="policy"><view class="input">携宠状态：{{policyChoices[form.policyIndex].name}}</view></picker><textarea class="textarea" data-field="petPolicyText" value="{{form.petPolicyText}}" bindinput="input" maxlength="500" placeholder="完整携宠条件、开放时段和待确认事项"/>
    <view class="label">已核实的公共场所坐标（选填）</view><view class="row"><input class="input" data-field="latitude" value="{{form.latitude}}" bindinput="input" placeholder="GCJ-02 纬度"/><input class="input" data-field="longitude" value="{{form.longitude}}" bindinput="input" placeholder="GCJ-02 经度"/></view><view class="row between"><text class="small">已核实为公共场所坐标</text><switch checked="{{form.pointConfirmed}}" bindchange="confirmPoint"/></view><view class="row between"><text>上架展示</text><switch checked="{{form.active}}" bindchange="active"/></view>
    <view class="row"><button class="btn btn-primary" bindtap="save" disabled="{{busy}}">保存</button><button class="btn btn-ghost" bindtap="closeForm">取消</button></view>
  </view>
  <view class="section-title">待处理纠错</view><view wx:if="{{!corrections.length}}" class="small muted">暂无待核实信息</view><view wx:for="{{corrections}}" wx:key="id" class="card management-record"><view bindtap="open" data-id="{{item.placeId}}">{{item.placeTitle}} ›</view><view class="small muted">{{item.category}}</view><view>{{item.text}}</view><button class="btn btn-secondary" data-id="{{item.id}}" bindtap="selectCorrection">填写处理结果</button><view wx:if="{{selectedCorrection === item.id}}"><textarea class="textarea" value="{{resolution}}" bindinput="resolution" maxlength="500" placeholder="说明核实与改动结果。请先在下方编辑地点资料，再标记处理完成。"/><view class="row"><button class="btn btn-primary" data-status="resolved" bindtap="resolve" disabled="{{busy}}">已核实并处理</button><button class="btn btn-ghost" data-status="dismissed" bindtap="resolve" disabled="{{busy}}">无需变更，说明原因</button></view></view></view>
  <view wx:if="{{correctionsError}}" class="error-box">{{correctionsError}}</view><button wx:if="{{correctionCursor}}" class="btn btn-ghost" bindtap="loadMoreCorrections" loading="{{correctionsBusy}}" disabled="{{correctionsBusy || loading}}">{{correctionsError ? '重试读取纠错' : '继续读取待处理纠错'}}</button>
  <view class="section-title">地点目录</view><view wx:for="{{items}}" wx:key="id" class="card management-record"><view class="row between"><view><view>{{item.title}}</view><view class="small muted">{{item.area}} · {{item.active === false ? '已下架' : '展示中'}}</view></view><button class="btn btn-secondary" bindtap="edit" data-id="{{item.id}}">编辑</button></view></view>
</block></view>
