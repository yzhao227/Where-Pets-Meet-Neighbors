<view class="page author-page"><view wx:if="{{loading}}" class="loading">正在打开作者主页…</view><view wx:elif="{{error}}" class="error-box"><text>{{error}}</text><button class="btn btn-secondary" bindtap="refresh">重新加载</button></view><block wx:else><view wx:if="{{mode === 'demo'}}" class="demo-label">本机体验 · 关注仅保存在当前设备</view><view class="author-header card"><view class="row"><image class="profile-avatar" src="{{user.avatar}}" mode="aspectFill"/><view class="author-heading"><view class="author-title">{{user.nickname}}</view><view class="author-caption">{{user.isMine ? '这是你的个人主页' : '因为喜欢宠物，在这里相遇'}}</view></view><button wx:if="{{!user.isMine}}" class="author-menu" bindtap="moreMenu" disabled="{{busy}}">•••</button></view><view wx:if="{{user.bio}}" class="public-bio">{{user.bio}}</view><view wx:if="{{user.pet && !pets.length}}" class="public-pet">🐾 {{user.pet.name}} · {{petText}}</view><view wx:for="{{pets}}" wx:key="id" class="author-pet"><image wx:if="{{item.photo}}" class="author-pet-photo" src="{{item.photo}}" mode="aspectFill"/><view wx:else class="author-pet-photo author-pet-empty">🐾</view><view><view class="author-pet-name">{{item.name}}</view><view class="author-pet-meta">{{item.typeName}}{{item.breed ? ' · ' + item.breed : ''}}{{item.ageLabel ? ' · ' + item.ageLabel : ''}}</view></view></view><view wx:if="{{!user.isEditorial && !user.publicProfile}}" class="privacy-note">{{privacyText}}</view><view class="author-stats"><view><text class="stat-number">{{user.postCount}}</text><text>篇分享</text></view><view><text class="stat-number">{{user.followerCount}}</text><text>位关注者</text></view><view><text class="stat-number">{{user.followingCount}}</text><text>位关注</text></view></view><button wx:if="{{user.isMine}}" class="btn btn-secondary follow-button" bindtap="editProfile">编辑资料与公开范围</button><button wx:else class="btn {{user.isFollowing ? 'btn-secondary' : 'btn-primary'}} follow-button" bindtap="follow" loading="{{busy}}" disabled="{{busy}}">{{user.isFollowing ? '已关注 · 取消关注' : '＋ 关注'}}</button></view><view wx:if="{{excludedAnimalTypes.length}}" class="small muted">已按你的动物偏好隐藏部分分享，可在社区首页调整。我的发布与收藏仍可查看。</view><view wx:if="{{preferenceError}}" class="small muted">{{preferenceError}}</view><view class="row between public-post-heading"><view class="section-title">{{user.isMine ? '我的公开分享' : 'TA 的公开分享'}}</view><text class="small muted">慢慢看，慢慢聊</text></view><view wx:if="{{posts.length === 0}}" class="empty"><view class="empty-title">{{nextCursor ? '这一批还没有可见内容' : excludedAnimalTypes.length ? '当前偏好下暂无可见分享' : '还没有公开分享'}}</view><view class="muted">{{nextCursor ? '可以继续查看更早的内容。' : '新的分享会出现在这里。'}}</view></view><view wx:else class="discovery-grid"><view wx:for="{{posts}}" wx:key="id" class="discovery-card" bindtap="openPost" data-id="{{item.id}}"><view wx:if="{{item.cover}}" class="discovery-cover-wrap"><image class="discovery-cover" src="{{item.cover}}" mode="aspectFill"/><text wx:if="{{item.images.length > 1}}" class="photo-count">{{item.images.length}} 图</text></view><view wx:elif="{{item.video}}" class="video-cover-fallback"><text>▷</text><view>视频分享 · {{item.videoDurationText}}</view></view><view wx:else class="text-cover text-{{item.kind}}"><view class="text-cover-kicker">{{item.kindSymbol}} {{item.kindText}}</view><view class="text-cover-copy">{{item.cardText}}</view></view><view class="discovery-body"><view wx:if="{{item.cover || item.title}}" class="discovery-title">{{item.displayTitle}}</view><view wx:if="{{item.topics.length}}" class="discovery-topic"># {{item.topics[0]}}</view><view wx:if="{{item.event}}" class="discovery-event" catchtap="openEvent" data-id="{{item.event.id}}">↗ 查看关联活动</view><view class="discovery-footer row between"><text class="post-time">{{item.timeText}}</text><button class="card-like {{item.isLiked ? 'liked' : ''}}" catchtap="like" data-id="{{item.id}}" disabled="{{busy}}"><text>{{item.isLiked ? '♥' : '♡'}}</text>{{item.likeCount}}</button></view><view class="discovery-meta">{{item.commentCount}} 个回应 · {{item.circle.name}}</view></view></view></view><button wx:if="{{nextCursor}}" class="btn btn-ghost" bindtap="loadMore" loading="{{moreBusy}}" disabled="{{moreBusy}}">继续查看分享</button></block></view>
