<view class="page">
  <view class="place-tabs"><button wx:for="{{tabs}}" wx:key="id" class="{{type === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectTab">{{item.name}}</button></view>
  <view wx:if="{{loading}}" class="loading">正在整理地点…</view><view wx:elif="{{error}}" class="error-box">{{error}}<button class="btn btn-secondary" bindtap="refresh">重试</button></view>
  <view wx:elif="{{!items.length}}" class="empty"><view>这里还没有记录</view><button class="btn btn-primary" bindtap="explore">发现附近好去处</button></view>
  <block wx:else><view wx:for="{{items}}" wx:key="id" class="card place-record">
    <block wx:if="{{type === 'saved'}}"><view class="place-title" bindtap="open" data-id="{{item.id}}">{{item.title}} ›</view><view class="muted">{{item.city}} {{item.area}}</view><view class="small muted">{{item.address}}</view><view wx:if="{{item.active === false}}" class="record-warning">地点已下架，可取消收藏</view><view wx:if="{{item.distanceText}}" class="small">{{item.distanceText}}</view></block>
    <block wx:elif="{{type === 'visits'}}"><view class="place-title" bindtap="open" data-id="{{item.placeId}}">{{item.place.title || '地点已不可用'}} ›</view><view class="muted">到访 {{item.visitedOn}} · 仅自己可见</view><view wx:if="{{item.note}}" class="record-note">{{item.note}}</view><button class="btn btn-secondary" bindtap="shareVisit" data-id="{{item.id}}">{{item.postId ? '查看到访分享' : '写到访分享'}}</button></block>
    <button class="btn btn-ghost remove-record" bindtap="remove" data-id="{{item.id}}" disabled="{{busy}}">{{type === 'saved' ? '取消收藏' : '删除记录'}}</button>
  </view></block>
  <view wx:if="{{moreBusy}}" class="loading">正在读取…</view>
</view>
