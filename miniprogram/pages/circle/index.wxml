<view class="page circle-page"><view wx:if="{{loading}}" class="loading">正在打开小圈子…</view><view wx:elif="{{error}}" class="error-box"><text>{{error}}</text><button class="btn btn-secondary" bindtap="refresh">重新加载</button></view><block wx:else><view class="circle-hero card"><view class="circle-symbol">{{circle.icon || '🐾'}}</view><view class="page-title">{{circle.name}}</view><view class="circle-description">{{circle.description}}</view><view class="circle-people">{{circle.memberCount}} 位同好在这里</view><button class="btn {{circle.isJoined ? 'btn-secondary' : 'btn-primary'}}" bindtap="join" loading="{{busy}}" disabled="{{busy}}">{{circle.isJoined ? '已加入 · 管理加入状态' : '加入小圈子'}}</button></view><view wx:if="{{mode === 'demo'}}" class="demo-label">本机体验 · 互动仅保存在当前设备</view><view class="welcome-note">🌿 不需要特别有趣，分享你真实的小日常就好。</view><view wx:if="{{excludedAnimalTypes.length}}" class="small muted">已按你的动物偏好隐藏部分分享，可在社区首页调整。我的发布与收藏仍可查看。</view><view wx:if="{{preferenceError}}" class="small muted">{{preferenceError}}</view><view class="row between feed-heading"><view class="section-title">圈子里的日常</view><button class="compose-link" bindtap="compose">＋ 分享</button></view><view wx:if="{{posts.length === 0}}" class="empty"><view class="empty-title">{{nextCursor ? '这一批还没有可见分享' : excludedAnimalTypes.length ? '当前偏好下暂无可见分享' : '还没有人开口'}}</view><view class="muted">{{nextCursor ? '可以继续查看更早的内容。' : excludedAnimalTypes.length ? '可在社区首页调整动物隐藏偏好。' : '介绍一下自己，或者说说今天遇到的小动物。'}}</view><button class="btn btn-secondary" bindtap="compose">分享第一件小事</button></view><view wx:for="{{posts}}" wx:key="id" class="post-card card" bindtap="openPost" data-id="{{item.id}}"><view class="row"><image class="avatar" src="{{item.author.avatar}}" mode="aspectFill" catchtap="openAuthor" data-id="{{item.author.id}}"/><view class="post-author" catchtap="openAuthor" data-id="{{item.author.id}}"><view class="author-name-line">{{item.author.nickname}}</view><view wx:if="{{item.author.petLabel}}" class="pet-byline">{{item.author.petLabel}}</view><view wx:if="{{item.timeText}}" class="small muted">{{item.timeText}}</view></view><text class="muted">↗</text></view><view wx:if="{{item.title}}" class="circle-post-title">{{item.title}}</view><view class="post-text">{{item.text}}</view><view wx:if="{{item.images.length}}" class="post-images images-{{item.images.length}}"><image wx:for="{{item.images}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill"/></view><view class="small muted response-count">{{item.commentCount}} 个回应</view></view><button wx:if="{{nextCursor && !loading}}" class="btn btn-ghost" bindtap="loadMore" loading="{{moreBusy}}" disabled="{{moreBusy}}">查看更多日常</button></block></view>
