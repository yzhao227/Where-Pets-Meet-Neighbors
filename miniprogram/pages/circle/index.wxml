<view class="page topic-content-page">
  <view wx:if="{{loading}}" class="loading">正在读取主题内容…</view>
  <view wx:elif="{{error}}" class="error-box"><text>{{error}}</text><button class="btn btn-secondary" bindtap="refresh">重新加载</button></view>
  <block wx:else>
    <view class="topic-hero"><view class="topic-kicker">{{topic ? '主题指南' : '内容分类'}}</view><view class="page-title">{{circle.name}}</view><view class="topic-description">{{circle.description}}</view></view>
    <view class="source-note">内容包括资料整理与作者分享，具体来源见每篇内容。</view>
    <view wx:if="{{excludedAnimalTypes.length}}" class="preference-note">已按你的动物偏好隐藏部分内容，可在首页调整。自己的记录与收藏仍可查看。</view>
    <view wx:if="{{preferenceError}}" class="preference-note">{{preferenceError}}</view>
    <view class="feed-heading"><view class="section-title">相关内容</view></view>
    <view wx:if="{{posts.length === 0}}" class="empty"><view class="empty-title">{{nextCursor ? '这一批还没有可见内容' : excludedAnimalTypes.length ? '当前偏好下暂无可见内容' : '这个主题暂时还没有内容'}}</view><view class="muted">{{nextCursor ? '可以继续查看后面的内容。' : excludedAnimalTypes.length ? '可在首页调整动物隐藏偏好。' : '可以返回主题指南，看看其他主题。'}}</view></view>
    <view wx:for="{{posts}}" wx:key="id" class="post-card card" bindtap="openPost" data-id="{{item.id}}" aria-role="button" aria-label="{{'查看内容：' + item.displayTitle}}">
      <view class="source-row"><text class="source-label">{{item.sourceLabel}}</text><text wx:if="{{item.timeText}}" class="post-time">{{item.timeText}}</text></view>
      <view wx:if="{{item.title}}" class="topic-post-title">{{item.title}}</view>
      <view wx:if="{{item.text}}" class="post-text">{{item.text}}</view>
      <view wx:if="{{item.previewImages.length}}" class="post-images images-{{item.previewImages.length}}"><image wx:for="{{item.previewImages}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill"/></view>
      <view class="post-source">{{item.sourceText}}</view>
    </view>
    <button wx:if="{{nextCursor && !loading}}" class="btn btn-ghost" bindtap="loadMore" loading="{{moreBusy}}" disabled="{{moreBusy}}">查看更多内容</button>
  </block>
</view>
