<view class="page event-page"><view wx:if="{{loading}}" class="loading">正在查看这次相遇…</view><view wx:elif="{{error}}" class="error-box"><text>{{error}}</text><button class="btn btn-secondary" bindtap="refresh">重新加载</button></view><block wx:else><view class="event-cover-wrap"><image class="event-cover" src="{{event.cover}}" mode="aspectFill"/><text class="cover-tag">{{event.petText}}</text></view><view wx:if="{{mode === 'demo'}}" class="demo-label">本机体验 · 报名仅保存在当前设备</view><view class="event-main card"><view class="row between"><text class="eyebrow">LET'S MAKE A LITTLE MEMORY</text><text class="status">{{event.statusText}}</text></view><view class="event-title">{{event.title}}</view><view class="host">由 {{event.hostName}} 发起 · 免费参与</view><view class="event-facts"><view class="fact"><text class="fact-icon">◷</text><view><view>{{event.timeText}}</view><view class="small muted">至 {{event.endText}}</view></view></view><view class="fact"><text class="fact-icon">⌖</text><view>{{event.location}}</view></view><view class="fact"><text class="fact-icon">♧</text><view>{{event.attendeeCount}} / {{event.capacity}} 人已报名<text wx:if="{{event.canJoin}}" class="remaining">还可加入 {{event.remaining}} 人</text></view></view></view><view wx:if="{{event.cancelled}}" class="cancel-banner">这次活动已取消。{{event.cancelReason || '请留意下一次活动。'}}</view><view wx:elif="{{event.isJoined}}" class="joined-banner">✓ 已为你留好位置。临时有事，记得提前取消。</view><button class="btn {{event.isJoined ? 'btn-secondary' : 'btn-primary'}} join-button" bindtap="join" loading="{{busy}}" disabled="{{busy || event.buttonDisabled}}">{{event.buttonText}}</button><view class="join-note">请先征得主人同意，再接触或喂食宠物。</view></view>
  <view class="description card"><view class="section-title">这次，一起做些什么</view><view class="description-text">{{event.description}}</view><view class="pet-note">{{event.petText}} · 第一次参加也欢迎</view><view class="row between event-tools"><button bindtap="report" disabled="{{busy}}">反馈活动问题</button><button wx:if="{{isAdmin}}" bindtap="edit">编辑 / 取消活动 ↗</button></view></view>
  <view class="section-title discussion-title">见面前，先聊聊 <text class="muted">{{comments.length}}</text></view><view class="comment-list card"><view wx:if="{{comments.length === 0}}" class="comment-empty">有想了解的事，可以在这里问问。</view><view wx:for="{{comments}}" wx:key="id" class="comment"><image class="comment-avatar" src="{{item.author.avatar}}" mode="aspectFill" catchtap="openAuthor" data-id="{{item.author.id}}"/><view class="comment-main"><view class="row between"><view class="author-name-stack" catchtap="openAuthor" data-id="{{item.author.id}}"><view class="comment-name">{{item.author.nickname}}<text wx:if="{{item.isMine}}" class="mine-tag">我</text></view><view wx:if="{{item.author.petLabel}}" class="pet-byline">{{item.author.petLabel}}</view></view><button class="more-button" bindtap="commentMenu" data-id="{{item.id}}" disabled="{{busy}}">•••</button></view><view wx:if="{{item.replyToName}}" class="reply-to">回应 {{item.replyToName}}</view><view class="comment-text">{{item.text}}</view><view class="row comment-actions"><text class="small muted">{{item.timeText}}</text><text bindtap="reply" data-id="{{item.id}}">回复</text></view></view></view></view><button wx:if="{{nextCursor && !loading}}" class="btn btn-ghost" bindtap="loadMore" loading="{{moreBusy}}" disabled="{{moreBusy}}">查看更多回应</button><view class="composer card"><view wx:if="{{replyName}}" class="reply-banner row between"><text>正在回应 {{replyName}}</text><text bindtap="cancelReply">取消</text></view><textarea class="comment-input" value="{{text}}" maxlength="300" placeholder="介绍一下自己，或问问活动安排…" bindinput="input" disabled="{{busy}}"/><view class="row between"><text class="small muted">{{text.length}} / 300</text><button class="send-button btn-primary" bindtap="send" loading="{{busy}}" disabled="{{busy || !text}}">送出回应 ↗</button></view></view></block></view>
