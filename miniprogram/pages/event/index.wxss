.event-cover-wrap{position:relative;border-radius:24rpx;overflow:hidden;height:352rpx;}
.event-cover{height:100%;width:100%;}
.cover-tag{position:absolute;bottom:22rpx;left:23rpx;padding:11rpx 20rpx;background:#FFFFFF;color:#B84735;border-radius:12rpx;font-size:22rpx;}
.demo-label{margin:18rpx 0;}
.event-main{padding:26rpx;margin-top:23rpx;}
.event-main .eyebrow{font-size:20rpx;letter-spacing:0;color:#B84735;}
.status{font-size:21rpx;color:#505863;white-space:nowrap;margin-left:10rpx;}
.event-title{font-size:39rpx;font-weight:700;line-height:1.45;margin:20rpx 0 15rpx;}
.host{font-size:22rpx;color:#66707A;}
.event-facts{margin:27rpx 0;padding:24rpx 0;border-top:1rpx solid #E9E5E1;border-bottom:1rpx solid #E9E5E1;}
.fact{display:flex;align-items:flex-start;gap:15rpx;font-size:26rpx;line-height:1.8;margin:9rpx 0;}
.fact-icon{font-size:31rpx;color:#D86D53;width:33rpx;min-width:33rpx;}
.fact .small{font-size:22rpx;}
.remaining{font-size:20rpx;color:#66707A;display:inline-block;margin-left:20rpx;}
.joined-banner,.cancel-banner{font-size:23rpx;line-height:1.75;border-radius:14rpx;padding:16rpx;margin-bottom:22rpx;background:#FFF3E6;color:#94603D;}
.cancel-banner{background:#FFF3E6;color:#94603D;}
button.join-button{width:100%;box-sizing:border-box;}
.join-note{text-align:center;font-size:21rpx;color:#66707A;margin-top:19rpx;line-height:1.8;}
.description{padding:28rpx;margin-top:24rpx;}
.description-text{font-size:27rpx;line-height:1.95;white-space:pre-wrap;margin-top:21rpx;color:#24262D;}
.pet-note{font-size:22rpx;color:#98604B;background:#FFF0E9;border-radius:12rpx;padding:15rpx 18rpx;margin-top:23rpx;}
.event-tools{margin-top:20rpx;}
.event-tools button{margin:0;padding:0;background:transparent;font-size:21rpx;line-height:2;color:#66707A;}
.discussion-title{margin:32rpx 0 21rpx;}
.discussion-title text{font-size:22rpx;margin-left:10rpx;}
.comment-list{padding:0 25rpx;}
.comment{display:flex;gap:16rpx;padding:25rpx 0;border-bottom:1rpx solid #E9E5E1;}
.comment:last-child{border-bottom:0;}
.comment-avatar{height:58rpx;width:58rpx;min-width:58rpx;border-radius:50%;}
.comment-main{flex:1;min-width:0;}
.comment-name{font-size:25rpx;font-weight:600;}
.mine-tag{font-size:19rpx;color:#B84735;background:#FFF0E9;padding:3rpx 9rpx;border-radius:8rpx;margin-left:10rpx;font-weight:400;}
.comment-text{font-size:27rpx;line-height:1.85;white-space:pre-wrap;margin:12rpx 0;}
button.more-button{padding:8rpx 4rpx;margin:0;background:transparent;color:#66707A;letter-spacing:3rpx;font-size:20rpx;line-height:1;}
.comment-actions{gap:26rpx;font-size:21rpx;color:#505863;}
.comment-actions .small{font-size:20rpx;}
.reply-to{font-size:22rpx;color:#505863;margin:10rpx 0 -4rpx;}
.comment-empty{text-align:center;padding:36rpx 0;color:#66707A;font-size:24rpx;}
.composer{padding:24rpx;margin-top:24rpx;}
.comment-input{width:100%;height:145rpx;font-size:27rpx;line-height:1.8;box-sizing:border-box;}
button.send-button{padding:0 25rpx;margin:0;border-radius:16rpx;height:66rpx;line-height:66rpx;font-size:24rpx;}
.reply-banner{font-size:22rpx;background:#EAF2F8;color:#516B80;border-radius:12rpx;padding:13rpx 15rpx;margin-bottom:18rpx;}
.joined-banner{background:#EAF2F8;color:#516B80;}
