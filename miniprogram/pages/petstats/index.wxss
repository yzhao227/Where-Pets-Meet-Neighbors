.petstats-page>.eyebrow{font-size:16rpx;letter-spacing:2rpx;margin-top:12rpx;}
.page-title{font-size:42rpx;margin:4rpx 0 18rpx;}
.subtitle{font-size:24rpx;line-height:1.85;margin-bottom:25rpx;}
.demo-label{margin-bottom:24rpx;}
.summary-grid{display:flex;flex-wrap:wrap;gap:15rpx;}
.summary-card{width:calc((100% - 15rpx)/2);background:#FFFFFF;border:1rpx solid #E9E5E1;border-radius:20rpx;padding:23rpx;display:flex;flex-direction:column;gap:10rpx;font-size:22rpx;color:#66707A;line-height:1.75;}
.summary-number{font-size:44rpx;font-weight:700;color:#24262D;}
.types-card{padding:27rpx;margin-top:25rpx;}
.type-stat{margin-top:26rpx;font-size:26rpx;color:#505863;}
.type-count{font-size:23rpx;color:#66707A;}
.type-track{height:12rpx;border-radius:20rpx;background:#F4F0EB;margin-top:14rpx;overflow:hidden;}
.type-progress{height:100%;background:#EF725B;border-radius:20rpx;}
.scope-note{font-size:23rpx;line-height:1.9;color:#516B80;background:#EAF2F8;padding:22rpx;border-radius:18rpx;margin-top:24rpx;}
.privacy-note{font-size:22rpx;line-height:1.9;color:#7B818A;margin:23rpx 6rpx;}
.no-pets{font-size:23rpx;color:#7B818A;text-align:center;margin-top:25rpx;}
.empty-title{font-size:29rpx;font-weight:650;margin-bottom:15rpx;}
