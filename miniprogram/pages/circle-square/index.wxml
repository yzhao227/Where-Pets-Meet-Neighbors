<view class="page topic-square-page">
  <view class="square-heading">从关心的主题开始</view>
  <view class="square-intro">按养宠主题查看已有资料与作者分享，具体来源见每篇内容。</view>
  <view class="topic-list">
    <button wx:for="{{topics}}" wx:key="id" class="topic-row" bindtap="openTopic" data-id="{{item.id}}" aria-label="{{'查看主题：' + item.name}}">
      <view class="topic-number">{{item.number}}</view>
      <view class="topic-info"><view class="topic-name">{{item.name}}</view><view class="topic-description">{{item.description}}</view></view>
      <view class="topic-arrow" aria-hidden="true"></view>
    </button>
  </view>
</view>
