.topic-square-page{padding:22rpx 28rpx 48rpx;}
.square-heading{font-size:36rpx;font-weight:650;line-height:1.5;color:#354333;}
.square-intro{font-size:24rpx;line-height:1.8;color:#858D7E;margin:12rpx 0 28rpx;}
.topic-list{background:#FFFFFF;border:1rpx solid #E7E8DE;border-radius:22rpx;overflow:hidden;}
.topic-square-page button.topic-row{display:flex;align-items:center;gap:22rpx;width:100%;padding:27rpx 24rpx;margin:0;background:transparent;text-align:left;line-height:1.6;border-bottom:1rpx solid #F0EFE7;}
.topic-square-page button.topic-row:last-child{border-bottom:0;}
.topic-number{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:70rpx;height:70rpx;background:#F2F5ED;border-radius:19rpx;font-size:27rpx;font-weight:500;color:#8A9B7D;}
.topic-info{flex:1;min-width:0;}
.topic-name{font-size:29rpx;font-weight:650;color:#3C4B36;line-height:1.5;word-break:break-word;}
.topic-description{font-size:23rpx;color:#8B9382;line-height:1.7;margin-top:6rpx;word-break:break-word;}
.topic-arrow{width:11rpx;height:11rpx;border-top:2rpx solid #ACB39F;border-right:2rpx solid #ACB39F;transform:rotate(45deg);flex-shrink:0;margin:0 4rpx;}
