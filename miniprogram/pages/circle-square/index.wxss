.circle-square-page{padding:20rpx 28rpx 48rpx;}
.square-intro{font-size:24rpx;line-height:1.8;color:#858C94;margin:0 0 22rpx;}
.circle-list{background:#FFFFFF;border:1rpx solid #E9E5E1;border-radius:22rpx;overflow:hidden;}
.circle-square-page button.circle-row{display:flex;align-items:flex-start;gap:20rpx;width:100%;padding:26rpx 22rpx;margin:0;background:transparent;text-align:left;line-height:1.6;border-bottom:1rpx solid #EFEBE6;}
.circle-square-page button.circle-row:last-child{border-bottom:0;}
.circle-symbol{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:82rpx;height:82rpx;background:#FAF3EC;border-radius:23rpx;font-size:43rpx;}
.circle-info{flex:1;min-width:0;}
.circle-name{font-size:28rpx;font-weight:650;color:#343B44;line-height:1.5;word-break:break-word;}
.circle-description{font-size:23rpx;color:#858C94;line-height:1.7;margin-top:7rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-word;}
.circle-meta{display:flex;align-items:center;gap:14rpx;flex-wrap:wrap;margin-top:12rpx;}
.circle-people{font-size:21rpx;color:#989DA3;}
.joined-label{font-size:19rpx;line-height:1.5;color:#B84735;background:#FFF0E9;padding:3rpx 10rpx;border-radius:7rpx;}
.circle-arrow{width:12rpx;height:12rpx;border-top:2rpx solid #B1B4B7;border-right:2rpx solid #B1B4B7;transform:rotate(45deg);flex-shrink:0;margin:14rpx 4rpx 0 0;}
.circle-square-page .error-box{font-size:25rpx;}
.circle-square-page .error-box .btn{min-height:70rpx;font-size:24rpx;margin-top:17rpx;}
.square-empty{padding:65rpx 26rpx;text-align:center;}
.empty-circle-symbol{font-size:78rpx;line-height:1;color:#D5C7BC;margin-bottom:24rpx;}
.empty-title{font-size:28rpx;font-weight:600;color:#69717A;line-height:1.6;}
.empty-copy{font-size:23rpx;color:#9A9FA5;line-height:1.9;margin-top:12rpx;}
