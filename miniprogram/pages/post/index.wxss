.demo-label{margin-bottom:20rpx;}
.post-page{padding-bottom:calc(152rpx + env(safe-area-inset-bottom));}
.post-detail{padding:0;overflow:hidden;}
.post-author-row{padding:22rpx 24rpx;}
.post-author-row .avatar{width:62rpx;height:62rpx;}
.detail-content{padding:22rpx 26rpx 26rpx;}
.detail-meta-row{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-top:14rpx;}
.circle-origin{display:flex;align-items:center;gap:10rpx;flex:0 1 auto;min-width:0;max-width:43%;}
.publish-meta{display:flex;align-items:center;justify-content:flex-end;gap:9rpx;flex:1;min-width:0;margin-left:auto;font-size:18rpx;line-height:1.7;color:#91969C;white-space:nowrap;}
.publish-time,.publish-separator{flex-shrink:0;}
.publish-separator{color:#C2C4C6;}
.publish-place{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.circle-caption{flex-shrink:0;font-size:21rpx;line-height:1.5;color:#92908C;}
.author-meta{flex:1;margin-left:8rpx;}
.author-name{font-size:26rpx;font-weight:600;margin-bottom:5rpx;}
.mine-tag{font-size:19rpx;color:#B84735;background:#FFF0E9;padding:3rpx 9rpx;border-radius:8rpx;margin-left:10rpx;font-weight:400;}
button.more-button{padding:8rpx 4rpx;margin:0;background:transparent;color:#66707A;letter-spacing:3rpx;font-size:23rpx;line-height:1;}
button.circle-link{font-size:22rpx;color:#A8644C;background:transparent;padding:8rpx 0;display:inline-flex;align-items:center;gap:12rpx;min-width:0;margin:0;line-height:1.5;text-align:left;}
.circle-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.circle-arrow{font-size:28rpx;color:#B6A397;flex-shrink:0;}
.detail-text{font-size:27rpx;line-height:1.85;white-space:pre-wrap;margin:18rpx 0;color:#41434A;}
.detail-photos{margin:0;}
.photo-frame{position:relative;background:#F1EEEA;overflow:hidden;}
.photo-proportion{height:0;}
.photo-gallery{position:absolute;top:0;left:0;width:100%;height:100%;}
.photo-slide{position:relative;height:100%;}
.gallery-image{width:100%;height:100%;display:block;opacity:0;}
.gallery-image.ready{opacity:1;}
.photo-feedback{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#737981;font-size:24rpx;pointer-events:none;}
.photo-feedback button{pointer-events:auto;}
.gallery-navigation{display:flex;align-items:center;gap:12rpx;padding:10rpx 16rpx 0;}
.gallery-navigation>button{display:flex;align-items:center;justify-content:center;width:44px;min-height:44px;padding:0;margin:0;font-size:38rpx;color:#696B6F;}
.gallery-navigation>button[disabled]{opacity:.25;}
.gallery-thumbnails{display:flex;flex:1;gap:10rpx;}
button.gallery-thumb{width:72rpx;height:72rpx;min-width:0;padding:3rpx;margin:0;border:2rpx solid transparent;border-radius:12rpx;overflow:hidden;}
button.gallery-thumb.selected{border-color:#CC4A37;}
.gallery-thumb image{display:block;width:100%;height:100%;border-radius:8rpx;}
.gallery-counter{font-size:22rpx;color:#777E85;white-space:nowrap;}
.detail-spinner{width:30rpx;height:30rpx;min-width:16px;min-height:16px;border:3rpx solid #DDD5CC;border-top-color:#C47459;border-radius:50%;animation:detail-spin .8s linear infinite;}
@keyframes detail-spin{to{transform:rotate(360deg);}}
.discussion-heading{margin:31rpx 0 20rpx;}
.discussion-heading .muted{font-size:22rpx;margin-left:8rpx;}
.tiny-flower{color:#EF725B;font-size:36rpx;}
.comment-list{padding:0 25rpx;}
.comment{display:flex;gap:16rpx;padding:25rpx 0;border-bottom:1rpx solid #E9E5E1;}
.comment:last-child{border-bottom:0;}
.comment-avatar{height:58rpx;width:58rpx;min-width:58rpx;border-radius:50%;}
.comment-main{flex:1;min-width:0;}
.comment-name{font-size:25rpx;font-weight:600;}
.comment-text{font-size:27rpx;line-height:1.85;white-space:pre-wrap;margin:12rpx 0;}
button.comment-more{font-size:20rpx;}
.comment-actions{gap:26rpx;font-size:21rpx;color:#505863;}
.comment-actions .small{font-size:20rpx;}
.reply-to{font-size:22rpx;color:#58738A;margin:10rpx 0 -4rpx;}
.comment-empty{text-align:center;padding:36rpx 0;color:#505863;font-size:26rpx;}
.comment-empty .small{margin-top:12rpx;font-size:22rpx;}
.post-dock{position:fixed;left:0;right:0;bottom:0;z-index:40;display:flex;align-items:center;gap:12rpx;padding:12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.98);border-top:1rpx solid #EAE6E1;box-shadow:0 -4rpx 20rpx rgba(36,38,45,.025);}
button.dock-comment-entry{display:flex;align-items:center;gap:10rpx;flex:1;min-width:0;min-height:76rpx;padding:14rpx 20rpx;margin:0;border-radius:40rpx;background:#F4F2EF;color:#8A8D91;text-align:left;font-size:24rpx;line-height:1.5;}
.dock-pencil{flex-shrink:0;font-size:32rpx;color:#8D9196;}
.dock-entry-text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
button.dock-action{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3rpx;flex:0 0 80rpx;min-width:44px;min-height:44px;padding:2rpx 0;margin:0;color:#41454C;background:transparent;line-height:1.1;}
.dock-symbol{font-size:43rpx;line-height:1;}
.dock-label{font-size:19rpx;line-height:1.4;white-space:nowrap;}
button.dock-action.is-liked{color:#CC4A37;}
button.dock-action.is-bookmarked{color:#B38240;}
.dock-comment-symbol{position:relative;width:34rpx;height:28rpx;margin:5rpx 0 7rpx;border:2.5rpx solid currentColor;border-radius:9rpx;}
.dock-comment-symbol::after{content:'';position:absolute;left:6rpx;bottom:-6rpx;width:8rpx;height:8rpx;background:#FFFFFF;border-left:2.5rpx solid currentColor;border-bottom:2.5rpx solid currentColor;transform:skewY(-30deg);}
.comment-editor-layer{position:fixed;inset:0;z-index:60;}
.comment-editor-mask{position:absolute;inset:0;background:rgba(30,32,38,.28);}
.comment-editor-sheet{position:absolute;left:0;right:0;display:flex;flex-direction:column;padding:22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));background:#FFFFFF;border-radius:28rpx 28rpx 0 0;box-shadow:0 -10rpx 40rpx rgba(36,38,45,.06);box-sizing:border-box;}
.comment-editor-sheet.keyboard-open{padding-bottom:18rpx;}
.editor-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;flex-shrink:0;margin-bottom:18rpx;font-size:27rpx;font-weight:600;}
button.editor-close{flex-shrink:0;padding:6rpx 0 6rpx 20rpx;color:#8B9095;font-size:23rpx;font-weight:400;}
.comment-input{width:100%;height:180rpx;min-height:72rpx;flex:0 1 180rpx;padding:20rpx 22rpx;border-radius:18rpx;background:#F6F5F3;font-size:27rpx;line-height:1.7;box-sizing:border-box;}
.editor-footer{display:flex;align-items:center;justify-content:space-between;gap:16rpx;flex-shrink:0;margin-top:18rpx;}
.comment-counter{font-size:21rpx;color:#95999D;}
button.send-button{padding:0 30rpx;margin:0;border-radius:32rpx;min-height:64rpx;line-height:64rpx;font-size:25rpx;}
.reply-banner{display:flex;flex-shrink:0;font-size:22rpx;background:#F8F0E9;color:#9B705A;border-radius:12rpx;padding:12rpx 15rpx;margin-bottom:16rpx;}
.reply-banner button{flex-shrink:0;padding:4rpx 0;color:#8C8D91;font-size:21rpx;}
.detail-title{font-size:32rpx;font-weight:650;line-height:1.55;margin:4rpx 0 18rpx;white-space:pre-wrap;}
.detail-tags{display:flex;flex-wrap:wrap;align-items:center;gap:10rpx;margin-top:20rpx;}
.detail-tag{font-size:22rpx;line-height:1.5;border-radius:10rpx;padding:7rpx 12rpx;max-width:100%;box-sizing:border-box;}
.animal-tag{color:#657784;background:#EDF3F5;}
.topic-tag{color:#B46A53;background:#FBF1EB;}
.linked-event{padding:23rpx;border-radius:20rpx;background:#EAF2F8;border:1rpx solid #E9E5E1;margin-top:25rpx;border-color:#DCE7F0;}
.linked-event-kicker{font-size:20rpx;color:#58738A;}
.linked-event-title{font-size:29rpx;line-height:1.6;font-weight:650;color:#24262D;margin-top:10rpx;}
.linked-event-meta{font-size:22rpx;line-height:1.8;color:#66707A;margin-top:9rpx;}
.linked-event-link{font-size:22rpx;color:#49667D;margin-top:17rpx;font-weight:600;}
.linked-unavailable{font-size:22rpx;color:#66707A;margin-top:22rpx;}
.linked-place{padding:22rpx;border-radius:18rpx;background:#F0F4EC;border:1rpx solid #E2E8DD;margin:22rpx 0;}
.linked-place-title{font-size:27rpx;line-height:1.5;font-weight:600;color:#405644;}
.linked-place-address,.linked-place-distance{font-size:22rpx;line-height:1.6;color:#697567;margin-top:7rpx;}
.linked-place-action{font-size:23rpx;color:#536D50;margin-top:12rpx;}
.image-credits{padding:20rpx;margin-top:20rpx;border:1rpx solid #E9E5E1;border-radius:16rpx;background:#FAF8F5;}
.image-credit{padding:18rpx 0;border-bottom:1rpx solid #E9E5E1;}
.image-credit:last-child{padding-bottom:0;border-bottom:0;}
.credit-title{font-size:23rpx;font-weight:600;color:#505863;line-height:1.7;}
.credit-license{display:inline-block;font-size:19rpx;font-weight:400;color:#516B80;background:#EAF2F8;padding:2rpx 8rpx;border-radius:6rpx;margin-left:12rpx;}
.credit-attribution{white-space:pre-wrap;}
.credit-links{display:flex;flex-wrap:wrap;gap:4rpx 24rpx;}
.credit-links button.source-link{flex:0 1 auto;margin:0;padding:12rpx 0 2rpx;min-height:54rpx;line-height:1.7;}
.detail-video video{width:100%;height:450rpx;border-radius:18rpx;background:#242A30;}
.detail-video{position:relative;min-height:450rpx;margin:0;background:#242A30;overflow:hidden;}
.video-buffer{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;}
.video-error{min-height:450rpx;padding:34rpx;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:#F6F3EF;border-radius:18rpx;font-size:24rpx;line-height:1.8;color:#707982;}

button.packaged-video-cover{position:relative;display:block;width:100%;height:540rpx;padding:0;margin:0;background:#242A30;border:0;overflow:hidden;}
.packaged-video-cover image{display:block;width:100%;height:100%;}
.packaged-video-play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12rpx;color:#fff;background:rgba(0,0,0,.12);font-size:24rpx;text-shadow:0 1px 5px #000;}
.packaged-video-play text:first-child{display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;border:2rpx solid rgba(255,255,255,.75);border-radius:50%;background:rgba(0,0,0,.4);font-size:36rpx;}
