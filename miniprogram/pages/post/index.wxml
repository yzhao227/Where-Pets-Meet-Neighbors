<page-meta page-style="{{commentOpen ? 'overflow:hidden;' : ''}}"></page-meta>
<view class="page post-page"><view wx:if="{{loading}}" class="loading">正在打开这篇内容…</view><view wx:elif="{{error}}" class="error-box"><text>{{error}}</text><button class="btn btn-secondary" bindtap="refresh">重新加载</button></view><block wx:else><view wx:if="{{mode === 'demo'}}" class="demo-label">本机体验 · 互动仅保存在当前设备</view><view class="post-detail card"><view class="row post-author-row"><image class="avatar" src="{{post.author.avatar}}" mode="aspectFill" catchtap="openAuthor" data-id="{{post.author.id}}"/><view class="author-meta" catchtap="openAuthor" data-id="{{post.author.id}}"><view class="author-name">{{post.author.nickname}}<text wx:if="{{post.isMine}}" class="mine-tag">我</text></view><view wx:if="{{post.author.petLabel}}" class="pet-byline">{{post.author.petLabel}}</view><view wx:if="{{post.timeText}}" class="small muted">{{post.timeText}}</view><button wx:if="{{post.isMine}}" class="post-visibility" catchtap="changeVisibility" disabled="{{busy}}" aria-label="修改可见范围，当前{{post.visibilityText}}">{{post.visibilityText}} · 可见范围</button><text wx:elif="{{post.visibility !== 'public'}}" class="post-visibility-label">{{post.visibilityText}}</text></view><button class="more-button" bindtap="more" disabled="{{busy}}">•••</button></view><view wx:if="{{post.video}}" class="detail-video">
  <button wx:if="{{videoPlayerPath}}" class="packaged-video-cover" bindtap="openVideo" aria-label="播放视频"><image src="{{post.video.poster || post.cover}}" mode="aspectFit"/><view class="packaged-video-play"><text>▶</text><text>播放视频</text></view></button>
  <video wx:elif="{{!videoError && videoSource}}" id="post-video" src="{{videoSource}}" data-src="{{videoSource}}" data-attempt="{{videoAttempt}}" poster="{{post.video.poster || post.cover || ''}}" controls="true" autoplay="false" object-fit="contain" show-mute-btn="true" show-fullscreen-btn="true" enable-play-gesture="true" binderror="videoFailed" bindwaiting="videoBuffering" bindloadedmetadata="videoReady" bindplay="videoReady" bindtimeupdate="videoReady" bindpause="videoReady"/>
  <view wx:if="{{videoWaiting && !videoError}}" class="video-buffer" role="status" aria-label="视频缓冲中"><view class="detail-spinner"></view></view>
  <view wx:if="{{videoError}}" class="video-error"><text>视频暂时无法播放，请稍后重试。</text><button class="btn btn-secondary" bindtap="retryVideo">重新加载视频</button></view>
</view>
<view wx:elif="{{photoItems.length}}" class="detail-photos">
  <view class="photo-frame">
  <view class="photo-proportion" style="padding-top:{{photoHeightPercent}}%;"></view>
  <swiper class="photo-gallery" current="{{photoIndex}}" bindchange="photoChanged" duration="220" aria-label="分享图片，可左右滑动">
    <swiper-item wx:for="{{photoItems}}" wx:key="src" class="photo-slide">
      <image wx:if="{{item.status !== 'error'}}" class="gallery-image {{item.status === 'ready' ? 'ready' : ''}}" src="{{item.src}}" mode="aspectFit" bindtap="preview" bindload="photoLoaded" binderror="photoFailed" data-src="{{item.src}}" data-index="{{index}}" data-attempt="{{item.attempt}}" aria-label="查看原图 {{index + 1}}"/>
      <view wx:if="{{item.status === 'loading'}}" class="photo-feedback" role="status" aria-label="图片加载中"><view class="detail-spinner"></view></view>
      <view wx:elif="{{item.status === 'error'}}" class="photo-feedback"><text>图片暂未加载</text><button class="btn btn-secondary" bindtap="retryPhoto" data-index="{{index}}">重试</button></view>
    </swiper-item>
  </swiper>
  </view>
  <view wx:if="{{photoItems.length > 1}}" class="gallery-navigation">
    <button bindtap="previousPhoto" disabled="{{photoIndex === 0}}" aria-label="上一张图片">‹</button>
    <view class="gallery-thumbnails"><button wx:for="{{photoItems}}" wx:key="src" class="gallery-thumb {{photoIndex === index ? 'selected' : ''}}" bindtap="selectPhoto" data-index="{{index}}" aria-label="切换到第 {{index + 1}} 张图片" aria-pressed="{{photoIndex === index}}"><image src="{{item.src}}" mode="aspectFill"/></button></view>
    <text class="gallery-counter">{{photoIndex + 1}} / {{photoItems.length}}</text>
    <button bindtap="nextPhoto" disabled="{{photoIndex === photoItems.length - 1}}" aria-label="下一张图片">›</button>
  </view>
</view><view class="detail-content"><view wx:if="{{post.title}}" class="detail-title">{{post.title}}</view><view wx:if="{{post.text}}" class="detail-text">{{post.text}}</view><view wx:if="{{post.animalLabels.length || post.topics.length}}" class="detail-tags">
  <text wx:for="{{post.animalLabels}}" wx:key="*this" class="detail-tag animal-tag">{{item}}</text>
  <text wx:for="{{post.topics}}" wx:key="*this" class="detail-tag topic-tag"># {{item}}</text>
</view><view class="detail-meta-row"><view class="circle-origin"><text class="circle-caption">来自</text><button class="circle-link" bindtap="openCircle" aria-label="查看圈子：{{post.circle.name}}"><text class="circle-name">◎ {{post.circle.name}}</text><text class="circle-arrow">›</text></button></view><view class="publish-meta"><text class="publish-time">{{post.publishTimeText}}</text><text class="publish-separator" aria-hidden="true">·</text><text class="publish-place">{{post.publishPlaceText}}</text></view></view><view wx:if="{{post.event}}" class="linked-event" bindtap="openEvent"><view class="linked-event-kicker">↗ 一起走到线下 · {{post.event.petText}}</view><view class="linked-event-title">{{post.event.title}}</view><view class="linked-event-meta">{{post.event.timeText}} · {{post.event.location}}</view><view class="linked-event-link">{{post.event.status === 'cancelled' ? '活动已取消 · 查看详情' : '查看活动与报名'}} ↗</view></view><view wx:elif="{{post.eventId}}" class="linked-unavailable">关联活动当前不可查看</view><view wx:if="{{post.place}}" class="linked-place" bindtap="openPlace" aria-label="查看地点：{{post.place.title}}"><view class="linked-place-title">⌖ {{post.place.title}}</view><view class="linked-place-address">{{post.place.address || post.place.area}}</view><view wx:if="{{post.placeDistanceText}}" class="linked-place-distance">{{post.placeDistanceText}}</view><view class="linked-place-action">{{post.place.active === false ? '地点信息已下架' : '查看带宠条件与导航'}} ›</view></view><view wx:if="{{post.hasRequiredCredits}}" class="image-credits"><block wx:for="{{post.imageCredits}}" wx:for-item="credit" wx:for-index="creditIndex" wx:key="imageUrl"><view wx:if="{{credit.requiresAttribution}}" class="image-credit"><view class="credit-title">图片 {{creditIndex + 1}} · {{credit.author}}<text wx:if="{{credit.licenseName}}" class="credit-license">{{credit.licenseName}}</text></view><view wx:if="{{credit.attribution}}" class="source-text credit-attribution"><text selectable="true">{{credit.attribution}}</text></view><view wx:if="{{credit.modifiedDescription}}" class="source-text">{{credit.modifiedDescription}}</view><view class="credit-links"><button wx:if="{{credit.sourceUrl}}" class="source-link" data-index="{{creditIndex}}" bindtap="copyImageSource">复制图片来源 ↗</button><button wx:if="{{credit.licenseUrl}}" class="source-link" data-index="{{creditIndex}}" bindtap="copyImageLicense">复制许可链接 ↗</button></view></view></block></view></view></view><view id="post-comments" class="row between discussion-heading"><view class="section-title">{{post.isEditorialContent ? '聊聊这篇内容' : '聊聊这件小事'}} <text class="muted">{{post.commentCount}}</text></view><text class="tiny-flower">✺</text></view><view class="comment-list card"><view wx:if="{{comments.length === 0}}" class="comment-empty"><view>还没有回应</view><view class="small muted">{{post.isEditorialContent ? '分享你的疑问或阅读收获。' : '一句「我也是」，就能开始一段交流。'}}</view></view><view wx:for="{{comments}}" wx:key="id" class="comment"><image class="comment-avatar" src="{{item.author.avatar}}" mode="aspectFill" catchtap="openAuthor" data-id="{{item.author.id}}"/><view class="comment-main"><view class="row between"><view class="author-name-stack" catchtap="openAuthor" data-id="{{item.author.id}}"><view class="comment-name">{{item.author.nickname}}<text wx:if="{{item.isMine}}" class="mine-tag">我</text></view><view wx:if="{{item.author.petLabel}}" class="pet-byline">{{item.author.petLabel}}</view></view><button class="more-button comment-more" bindtap="commentMenu" data-id="{{item.id}}" disabled="{{busy}}">•••</button></view><view wx:if="{{item.replyToName}}" class="reply-to">回应 {{item.replyToName}}</view><view class="comment-text">{{item.text}}</view><view class="row comment-actions"><text class="small muted">{{item.timeText}}</text><text bindtap="reply" data-id="{{item.id}}">回复</text></view></view></view></view><button wx:if="{{nextCursor && !loading}}" class="btn btn-ghost" bindtap="loadMore" loading="{{moreBusy}}" disabled="{{moreBusy}}">查看更多回应</button>
<view wx:if="{{!commentOpen}}" class="post-dock" role="toolbar" aria-label="评论、点赞与收藏">
  <button class="dock-comment-entry" bindtap="openComment" disabled="{{busy}}" aria-label="写评论"><text class="dock-pencil">✎</text><text class="dock-entry-text">{{hasCommentText ? '继续写评论…' : replyName ? '回复 ' + replyName : '说点什么…'}}</text></button>
  <button class="dock-action {{post.isLiked ? 'is-liked' : ''}}" bindtap="like" disabled="{{busy}}" aria-label="{{post.isLiked ? '取消点赞' : '点赞'}}" aria-pressed="{{post.isLiked}}"><text class="dock-symbol">{{post.isLiked ? '♥' : '♡'}}</text><text class="dock-label">{{post.likeCount}}</text></button>
  <button class="dock-action {{post.isBookmarked ? 'is-bookmarked' : ''}}" bindtap="bookmark" disabled="{{busy}}" aria-label="{{post.isBookmarked ? '取消收藏' : '收藏'}}" aria-pressed="{{post.isBookmarked}}"><text class="dock-symbol">{{post.isBookmarked ? '★' : '☆'}}</text><text class="dock-label">{{post.isBookmarked ? '已收藏' : '收藏'}}</text></button>
  <button class="dock-action" bindtap="showComments" aria-label="查看评论，共 {{post.commentCount}} 条"><view class="dock-comment-symbol"></view><text class="dock-label">{{post.commentCount}}</text></button>
</view>
<view wx:if="{{commentOpen}}" class="comment-editor-layer">
  <view class="comment-editor-mask" bindtap="closeComment" catchtouchmove="preventBackgroundScroll"></view>
  <view class="comment-editor-sheet {{keyboardHeight ? 'keyboard-open' : ''}}" style="bottom:{{keyboardHeight}}px;max-height:calc(100% - {{keyboardHeight}}px);" role="dialog" aria-modal="true" aria-label="{{replyName ? '回复 ' + replyName : '写评论'}}">
    <view class="editor-heading"><text>{{replyName ? '回复 ' + replyName : '写评论'}}</text><button class="editor-close" bindtap="closeComment" disabled="{{busy}}" aria-label="收起评论输入">收起</button></view>
    <view wx:if="{{replyName}}" class="reply-banner row between"><text>正在回复 {{replyName}}</text><button bindtap="cancelReply" disabled="{{busy}}">取消回复</button></view>
    <textarea class="comment-input" value="{{text}}" maxlength="300" placeholder="说点温暖、真实的话…" bindinput="input" disabled="{{busy}}" focus="{{commentFocused}}" fixed="{{true}}" adjust-position="{{false}}" show-confirm-bar="{{false}}" cursor-spacing="20" bindkeyboardheightchange="commentKeyboardChanged" bindfocus="commentKeyboardChanged"/>
    <view class="editor-footer"><text class="comment-counter">{{text.length}} / 300</text><button class="send-button btn-primary" bindtap="send" loading="{{busy}}" disabled="{{busy || !hasCommentText}}">发送</button></view>
  </view>
</view>
</block></view>
