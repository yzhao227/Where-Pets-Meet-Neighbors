.community-navbar{position:sticky;top:0;z-index:30;background:#FAF8F5;}
.community-navbar-row,.community-brand{display:flex;align-items:center;justify-content:center;}
.community-brand{gap:9rpx;min-width:0;white-space:nowrap;font-size:40rpx;font-weight:700;line-height:1.2;color:#24262D;}
.brand-logo{width:40rpx;height:40rpx;flex-shrink:0;}
.community-page{padding:8rpx 24rpx 36rpx;}
.feed-navigation{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:8rpx;}
.feed-tabs,.feed-actions{display:flex;align-items:center;}
.feed-tabs{gap:16rpx;flex-shrink:0;}
.feed-actions{gap:12rpx;flex:1;min-width:0;justify-content:flex-end;}
.community-page button.feed-tab{position:relative;display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;font-size:31rpx;color:#747B85;padding:0 0 5rpx;font-weight:500;line-height:1.5;white-space:nowrap;}
.community-page button.feed-tab.selected{color:#24262D;font-weight:750;}
.feed-tab.selected::before{content:"";height:5rpx;width:30rpx;border-radius:4rpx;background:#EF725B;position:absolute;bottom:3rpx;left:50%;transform:translateX(-50%);}
.community-page button.publish-shortcut{display:flex;align-items:center;justify-content:center;flex:0 0 44px;width:44px;min-width:44px;min-height:44px;padding:0;line-height:1;}
.publish-label{display:flex;align-items:center;justify-content:center;width:36px;height:36px;background:#CC4A37;color:#FFFFFF;border-radius:11px;font-size:27px;font-weight:400;line-height:1;}
.search-bar{display:flex;align-items:center;flex:1;min-width:0;max-width:120px;height:36px;padding:0 4px 0 0;margin:0;border:1rpx solid #E9E5E1;background:#FFFFFF;border-radius:18px;}
.search-bar.active,.search-bar:focus-within{border-color:#D9BAAE;background:#FFFCF8;}
.search-input{width:0;min-width:0;flex:1;height:36px;padding:0;border:0;outline:none;background:transparent;font-size:24rpx;color:#24262D;}
.community-page .search-button{display:flex;align-items:center;justify-content:center;flex:0 0 44px;width:44px;min-width:44px;height:44px;padding:0;margin:0;line-height:1;background:transparent;}
.search-symbol{position:relative;width:14px;height:14px;margin:0 4px 4px 0;border:1.5px solid #777F89;border-radius:50%;}
.search-symbol::after{content:"";position:absolute;right:-5px;bottom:-3px;width:7px;height:1.5px;border-radius:2px;background:#777F89;transform:rotate(45deg);}
.community-page .search-clear{display:flex;align-items:center;justify-content:center;flex:0 0 28px;width:28px;min-width:28px;height:44px;padding:0;margin:0;line-height:1;font-size:22px;background:transparent;color:#777F89;}
.browse-tools{display:flex;align-items:center;gap:14rpx;min-height:44px;margin:0 0 12rpx;}
.community-page button.browse-tool{display:flex;align-items:center;gap:12rpx;min-height:36px;max-width:72%;min-width:0;padding:0 22rpx;border:1rpx solid transparent;border-radius:40rpx;font-size:23rpx;color:#686B70;background:#F0EDE8;margin:0;line-height:1.5;}
.filter-button-label{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.community-page button.browse-tool.active{color:#AE513E;background:#F8E8DF;border-color:#F3DDD0;}
.filter-symbol{display:flex;flex-direction:column;justify-content:space-between;width:13px;height:11px;flex-shrink:0;}
.filter-symbol>view{position:relative;height:1.5px;background:currentColor;border-radius:2px;}
.filter-symbol>view::after{content:"";position:absolute;left:3px;top:-2px;width:3px;height:5px;background:currentColor;border-radius:2px;}
.filter-symbol>view:last-child::after{left:8px;}
.filter-count{padding:3rpx 11rpx;border-radius:20rpx;background:rgba(255,255,255,.62);font-size:20rpx;font-weight:500;white-space:nowrap;color:#AA624E;}
.topic-symbol{font-size:29rpx;line-height:1;font-weight:500;opacity:.8;}
.filter-dot{width:6rpx;height:6rpx;background:currentColor;border-radius:50%;flex-shrink:0;}
.community-page button.topic-tool{flex-shrink:1;}
.topic-scroll{white-space:nowrap;margin-bottom:18rpx;}
.topic-track{display:flex;gap:12rpx;}
.topic-chip{white-space:nowrap;border:1rpx solid #E9E5E1;border-radius:32rpx;padding:12rpx 20rpx;font-size:23rpx;color:#606872;background:#FFFFFF;flex-shrink:0;}
.topic-chip.chosen{background:#F8E8DF;color:#AE513E;border-color:#F3DDD0;font-weight:600;}
.community-page .discovery-grid{display:flex;flex-wrap:nowrap;align-items:flex-start;gap:16rpx;}
.discovery-column{flex:1;min-width:0;}
.community-page .discovery-card{width:100%;margin-bottom:18rpx;background:#FFFFFF;border:1rpx solid #F0ECE7;border-radius:19rpx;overflow:hidden;}
.community-page .discovery-cover-wrap{position:relative;height:0;padding-bottom:140%;background:#F1EEEA;overflow:hidden;}
.community-page .discovery-cover-wrap.cover-portrait{padding-bottom:150%;}
.community-page .discovery-cover-wrap.cover-landscape{padding-bottom:140%;}
.community-page .discovery-cover{position:absolute;inset:0;width:100%;height:100%;opacity:0;transition:opacity .18s ease;}
.community-page .discovery-cover.is-ready{opacity:1;}
.media-placeholder{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:15rpx;background:#F1EEEA;color:#8D857D;font-size:24rpx;line-height:1.5;}
.media-loading{background:linear-gradient(135deg,#F3F0EC,#EBE6DF);color:#A49B92;}
.placeholder-picture{position:relative;width:54rpx;height:44rpx;border:3rpx solid #C2B9AF;border-radius:8rpx;overflow:hidden;}
.placeholder-picture::before{content:"";position:absolute;width:8rpx;height:8rpx;left:8rpx;top:7rpx;border-radius:50%;background:#C2B9AF;}
.placeholder-picture::after{content:"";position:absolute;right:1rpx;bottom:-13rpx;width:32rpx;height:32rpx;border:3rpx solid #C2B9AF;transform:rotate(45deg);border-radius:4rpx;}
.community-page button.retry-cover{display:flex;align-items:center;justify-content:center;min-width:64px;min-height:36px;font-size:24rpx;color:#A65240;padding:0 18rpx;border-radius:14rpx;background:#FFFFFF;}
.community-page .cover-kind{position:absolute;top:14rpx;bottom:auto;left:14rpx;max-width:70%;padding:6rpx 12rpx;border-radius:10rpx;font-size:22rpx;font-weight:600;line-height:1.4;color:#775A45;background:rgba(255,251,241,.95);}
.community-page .cover-kind.kind-question{background:rgba(238,245,250,.96);color:#486C85;}
.community-page .cover-kind.kind-meetup{background:rgba(242,247,235,.96);color:#61724B;}
.community-page .photo-count{top:14rpx;right:14rpx;padding:6rpx 10rpx;border-radius:10rpx;font-size:22rpx;line-height:1.4;background:rgba(33,36,40,.65);}
.video-mark{position:absolute;right:14rpx;bottom:14rpx;padding:6rpx 12rpx;border-radius:10rpx;background:rgba(25,29,35,.7);color:#FFFFFF;font-size:22rpx;line-height:1.4;}
.cover-place{position:absolute;left:10rpx;right:10rpx;bottom:10rpx;padding:7rpx 10rpx;border-radius:9rpx;background:rgba(25,29,35,.6);color:#fff;font-size:20rpx;line-height:1.4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.cover-place.above-video{bottom:58rpx;}
.community-page .video-cover-fallback{height:320rpx;background:#EEF1F1;}
.community-page .discovery-body{padding:12rpx 14rpx 6rpx;}
.community-page .discovery-title{font-size:23rpx;font-weight:600;line-height:1.45;color:#292C32;}
.discovery-labels{display:flex;align-items:center;gap:10rpx;min-width:0;margin-top:4rpx;}
.discovery-label{display:flex;align-items:center;gap:4rpx;min-width:0;max-width:58%;padding:3rpx 0;font-size:19rpx;line-height:1.4;color:#827569;}
.topic-label{flex:1;color:#777E85;}
.label-symbol{flex-shrink:0;font-size:21rpx;}
.label-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.community-page .discovery-footer{margin-top:3rpx;gap:6rpx;min-height:32px;}
.community-page .discovery-author{min-height:32px;gap:7rpx;}
.community-page .discovery-author image{width:30rpx;height:30rpx;min-width:30rpx;}
.community-page .discovery-author .author-name-line{display:block;min-width:0;font-size:20rpx;line-height:1.4;color:#737981;}
.community-page button.card-like{display:flex;align-items:center;justify-content:flex-end;gap:5rpx;min-width:36px;min-height:32px;padding:0;font-size:20rpx;}
.community-page button.card-like>text{font-size:28rpx;}
.community-page button.card-like .like-count{font-size:20rpx;}
.community-page .text-cover{min-height:280rpx;padding:24rpx 20rpx;background:#F8EFE8;}
.community-page .text-question{background:#EDF3F7;}
.community-page .text-cover-copy{font-size:30rpx;line-height:1.65;-webkit-line-clamp:6;}
.community-page .text-cover-kicker{font-size:24rpx;margin-bottom:14rpx;}
.community-page .discovery-event{font-size:23rpx;padding:7rpx 10rpx;margin-top:12rpx;}
.circle-discovery{padding:8rpx 0;}
.circle-heading{font-size:28rpx;font-weight:600;}
.circle-discovery .small{font-size:22rpx;}
.circle-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin:18rpx 0 22rpx;}
button.circle-tile{width:100%;min-width:0;padding:20rpx 16rpx;border:1rpx solid #E9E5E1;background:#FFFFFF;display:flex;gap:12rpx;align-items:center;border-radius:20rpx;text-align:left;line-height:1.5;}
.circle-icon{font-size:28rpx;flex-shrink:0;width:45rpx;height:45rpx;line-height:45rpx;text-align:center;border-radius:14rpx;background:#F4F2EE;}
.circle-name{font-size:26rpx;font-weight:600;}
.circle-count{font-size:22rpx;color:#747B83;margin-top:5rpx;}
.circle-filter-scroll{white-space:nowrap;margin-bottom:20rpx;}
.circle-filter{font-size:24rpx;color:#747B85;border-bottom:2rpx solid transparent;padding:9rpx 3rpx;flex-shrink:0;}
.circle-filter.selected{color:#B84735;border-color:#EF725B;font-weight:600;}
.circle-feed .discovery-column{width:100%;}
.circle-feed .discovery-body{padding:12rpx 24rpx;}
.discussion-preview{padding:24rpx;}
.discussion-kicker{font-size:23rpx;color:#858B91;margin-bottom:12rpx;}
.discussion-title{font-size:32rpx;font-weight:600;line-height:1.5;margin-bottom:12rpx;word-break:break-word;}
.discussion-text{font-size:28rpx;line-height:1.8;white-space:pre-wrap;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;color:#505863;word-break:break-word;}
.community-page .circle-feed .discovery-cover-wrap{padding-bottom:65%;}
.circle-feed .discovery-topic{font-size:24rpx;color:#858B91;margin:0;}
.circle-feed .discovery-meta{font-size:23rpx;margin:0;color:#858B91;}
.search-result{font-size:24rpx;color:#516B80;background:#EAF2F8;border-radius:14rpx;padding:14rpx 17rpx;margin:0 0 18rpx;}
.search-result>text:first-child{flex:1;word-break:break-all;}
.feed-load-state{display:flex;align-items:center;justify-content:center;min-height:64px;}
.feed-loading-spinner{width:32rpx;height:32rpx;min-width:16px;min-height:16px;border:3rpx solid #E8DED5;border-top-color:#C47459;border-radius:50%;animation:feed-spin .8s linear infinite;}
@keyframes feed-spin{to{transform:rotate(360deg);}}
.empty-title{font-size:30rpx;font-weight:600;color:#343741;margin:18rpx 0 12rpx;}
.empty .btn{margin-top:18rpx;}
.community-page .empty-continuable{min-height:calc(100vh - 180px);}
.community-filter-layer{position:fixed;inset:0;z-index:70;}
.filter-mask{position:absolute;inset:0;background:rgba(35,31,28,.32);touch-action:none;}
.animal-filter-sheet{position:absolute;left:0;right:0;bottom:0;background:#FAF8F5;border-radius:32rpx 32rpx 0 0;overflow:hidden;}
.sheet-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:26rpx 26rpx 20rpx;}
.sheet-title{font-size:34rpx;font-weight:650;color:#292C32;line-height:1.5;}
.sheet-caption{font-size:24rpx;color:#858B91;margin-top:4rpx;}
button.sheet-close{min-width:44px;min-height:44px;font-size:40rpx;line-height:1;color:#81868D;}
.sheet-content{height:56vh;max-height:760rpx;padding:0 26rpx;}
.animal-chips{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:20rpx;}
button.animal-chip{display:flex;align-items:center;justify-content:center;min-height:40px;font-size:24rpx;padding:10rpx 16rpx;border-radius:14rpx;background:#FFFFFF;color:#606872;border:1rpx solid #E9E5E1;margin:0;line-height:1.5;}
button.animal-chip.chosen{background:#FFF0E9;border-color:#E8B6A7;color:#B84735;font-weight:600;}
button.animal-chip.hidden-chosen{background:#EAF2F5;border-color:#A4BDC8;color:#496572;}
.hidden-section{border-top:1rpx solid #E8E3DC;padding:18rpx 0 24rpx;margin-top:24rpx;}
.filter-label{font-size:27rpx;font-weight:600;margin:10rpx 0 18rpx;}
.filter-note{font-size:23rpx;font-weight:400;color:#858B91;line-height:1.7;}
.filter-error{font-size:24rpx;color:#986245;line-height:1.7;margin-top:12rpx;}
button.clear-hidden{min-height:44px;font-size:24rpx;color:#617B88;padding:0 8rpx;}
.sheet-footer{padding:16rpx 26rpx calc(22rpx + env(safe-area-inset-bottom));border-top:1rpx solid #E8E3DC;background:#FAF8F5;}
button.sheet-done{display:flex;align-items:center;justify-content:center;width:100%;min-height:44px;background:#CC4A37;color:#FFFFFF;border-radius:16rpx;font-size:28rpx;line-height:1.5;}
@media(max-width:350px){.community-page .discovery-title{font-size:11.5px;}.community-page .text-cover-copy{font-size:14px;}.community-page .discovery-label,.community-page .discovery-author .author-name-line,.community-page button.card-like .like-count{font-size:10px;}.community-page button.browse-tool,.media-placeholder{font-size:12px;}.feed-tabs{gap:12rpx;}.feed-actions{gap:6rpx;}.community-page button.feed-tab{font-size:30rpx;}}
