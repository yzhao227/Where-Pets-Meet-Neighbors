.community-navbar{position:sticky;top:0;z-index:30;background:#FAF8F5;}
.community-navbar-row,.community-brand{display:flex;align-items:center;justify-content:center;}
.community-brand{gap:10rpx;min-width:0;white-space:nowrap;font-size:42rpx;font-weight:700;line-height:1.2;color:#24262D;}
.brand-logo{width:40rpx;height:40rpx;flex-shrink:0;}
.community-page{padding:12rpx 24rpx 36rpx;}
.feed-navigation{display:flex;align-items:center;justify-content:space-between;gap:24rpx;margin-bottom:16rpx;}
.feed-tabs{display:flex;align-items:center;gap:30rpx;min-width:0;}
.community-page button.feed-tab{position:relative;display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;font-size:34rpx;color:#737981;padding:0 0 8rpx;font-weight:500;line-height:1.5;white-space:nowrap;}
.community-page button.feed-tab.selected{color:#24262D;font-weight:700;}
.feed-tab.selected::before{content:"";height:5rpx;width:32rpx;border-radius:4rpx;background:#CC4A37;position:absolute;bottom:2rpx;left:50%;transform:translateX(-50%);}
.community-page button.publish-shortcut{display:flex;align-items:center;justify-content:center;flex:0 0 44px;width:44px;min-width:44px;min-height:44px;padding:0;line-height:1;}
.publish-label{display:flex;align-items:center;justify-content:center;width:36px;height:36px;background:#CC4A37;color:#FFFFFF;border-radius:50%;font-size:27px;font-weight:400;line-height:1;}
.search-bar{display:flex;align-items:center;flex:1 1 0;min-width:88px;height:44px;padding:0 8rpx 0 0;margin:0;border:1rpx solid #EAE5DE;background:#F0EDE8;border-radius:24rpx;}
.search-bar.active,.search-bar:focus-within{border-color:#CC4A37;background:#FFFFFF;}
.search-input{width:0;min-width:0;flex:1;height:44px;padding:0;border:0;outline:none;background:transparent;font-size:26rpx;color:#24262D;}
.search-placeholder{color:#737981;}
.community-page .search-button{display:flex;align-items:center;justify-content:center;flex:0 0 44px;width:44px;min-width:44px;height:44px;padding:0;margin:0;line-height:1;background:transparent;}
.search-symbol{position:relative;width:14px;height:14px;margin:0 4px 4px 0;border:1.5px solid #777F89;border-radius:50%;}
.search-symbol::after{content:"";position:absolute;right:-5px;bottom:-3px;width:7px;height:1.5px;border-radius:2px;background:#777F89;transform:rotate(45deg);}
.community-page .search-clear{display:flex;align-items:center;justify-content:center;flex:0 0 44px;width:44px;min-width:44px;height:44px;padding:0;margin:0;line-height:1;font-size:22px;background:transparent;color:#737981;}
.browse-tools{display:flex;align-items:center;gap:12rpx;min-height:44px;margin:0 0 24rpx;}
.browse-tools.searching{flex-wrap:wrap;}
.browse-tools.searching .search-bar{flex-basis:100%;}
.community-page button.browse-tool{display:flex;align-items:center;justify-content:center;gap:8rpx;min-height:44px;max-width:38%;min-width:0;flex:0 1 auto;padding:0 14rpx;border:1rpx solid transparent;border-radius:24rpx;font-size:25rpx;color:#626973;background:transparent;margin:0;line-height:1.5;}
.filter-button-label{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.community-page button.browse-tool.active{color:#B64030;background:#F9EBE6;border-color:#EED4C9;}
.filter-symbol{display:flex;flex-direction:column;justify-content:space-between;width:13px;height:11px;flex-shrink:0;}
.filter-symbol>view{position:relative;height:1.5px;background:currentColor;border-radius:2px;}
.filter-symbol>view::after{content:"";position:absolute;left:3px;top:-2px;width:3px;height:5px;background:currentColor;border-radius:2px;}
.filter-symbol>view:last-child::after{left:8px;}
.filter-count{padding:3rpx 6rpx;border-radius:8rpx;background:rgba(255,255,255,.7);font-size:20rpx;font-weight:500;white-space:nowrap;color:#A84836;}
.topic-symbol{font-size:29rpx;line-height:1;font-weight:500;opacity:.8;}
.filter-dot{width:6rpx;height:6rpx;background:currentColor;border-radius:50%;flex-shrink:0;}
.community-page button.topic-tool{max-width:25%;}
.topic-scroll{white-space:nowrap;margin-top:-8rpx;margin-bottom:24rpx;}
.topic-track{display:flex;gap:12rpx;}
.community-page button.topic-chip{display:flex;align-items:center;justify-content:center;min-height:44px;white-space:nowrap;border:1rpx solid #E9E5E1;border-radius:20rpx;padding:10rpx 22rpx;font-size:25rpx;color:#606872;background:#FFFFFF;flex-shrink:0;line-height:1.5;}
.community-page button.topic-chip.chosen{background:#F9EBE6;color:#B64030;border-color:#EED4C9;font-weight:600;}
.community-page .discovery-grid{display:flex;flex-wrap:nowrap;align-items:flex-start;gap:20rpx;}
.discovery-column{flex:1;min-width:0;}
.community-page .discovery-card{width:100%;margin-bottom:28rpx;background:transparent;border:0;border-radius:0;overflow:visible;}
.community-page .discovery-cover-wrap{position:relative;height:0;padding-bottom:140%;border-radius:22rpx;background:#F1EEEA;overflow:hidden;}
.community-page .discovery-cover-wrap.cover-portrait{padding-bottom:150%;}
.community-page .discovery-cover-wrap.cover-landscape{padding-bottom:140%;}
.community-page .discovery-cover{position:absolute;inset:0;width:100%;height:100%;opacity:0;transition:opacity .18s ease;}
.community-page .discovery-cover.is-ready{opacity:1;}
.media-placeholder{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:15rpx;background:#F1EEEA;color:#8D857D;font-size:24rpx;line-height:1.5;}
.media-loading{background:#F0EDE8;color:#79746D;}
.placeholder-picture{position:relative;width:54rpx;height:44rpx;border:3rpx solid #C2B9AF;border-radius:8rpx;overflow:hidden;}
.placeholder-picture::before{content:"";position:absolute;width:8rpx;height:8rpx;left:8rpx;top:7rpx;border-radius:50%;background:#C2B9AF;}
.placeholder-picture::after{content:"";position:absolute;right:1rpx;bottom:-13rpx;width:32rpx;height:32rpx;border:3rpx solid #C2B9AF;transform:rotate(45deg);border-radius:4rpx;}
.community-page button.retry-cover{display:flex;align-items:center;justify-content:center;min-width:64px;min-height:44px;font-size:26rpx;color:#B64030;padding:0 18rpx;border-radius:14rpx;background:#FFFFFF;}
.community-page .cover-kind{position:absolute;top:14rpx;bottom:auto;left:14rpx;max-width:70%;padding:6rpx 12rpx;border-radius:10rpx;font-size:22rpx;font-weight:600;line-height:1.4;color:#775A45;background:rgba(255,251,241,.95);}
.community-page .cover-kind.kind-question{background:rgba(238,245,250,.96);color:#486C85;}
.community-page .cover-kind.kind-meetup{background:rgba(242,247,235,.96);color:#61724B;}
.community-page .photo-count{top:14rpx;right:14rpx;padding:6rpx 10rpx;border-radius:10rpx;font-size:22rpx;line-height:1.4;background:rgba(33,36,40,.65);}
.cover-place{position:absolute;left:10rpx;right:10rpx;bottom:10rpx;padding:7rpx 10rpx;border-radius:9rpx;background:rgba(25,29,35,.6);color:#fff;font-size:20rpx;line-height:1.4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.community-page .discovery-body{padding:16rpx 4rpx 0;}
.community-page .discovery-title{font-size:28rpx;font-weight:600;line-height:1.5;color:#24262D;}
.discovery-labels{display:flex;align-items:center;gap:10rpx;min-width:0;margin-top:5rpx;}
.discovery-label{display:flex;align-items:center;gap:4rpx;min-width:0;max-width:58%;min-height:28px;padding:3rpx 0;font-size:22rpx;line-height:1.4;color:#796C60;}
.topic-label{flex:1;color:#737981;}
.label-symbol{flex-shrink:0;font-size:23rpx;}
.label-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.community-page .discovery-footer{margin-top:0;gap:8rpx;min-height:44px;}
.community-page .discovery-author{min-height:44px;gap:8rpx;}
.community-page .discovery-author image{width:34rpx;height:34rpx;min-width:34rpx;}
.community-page .discovery-author .author-name-line{display:block;min-width:0;font-size:22rpx;line-height:1.4;color:#737981;}
.community-page button.card-like{display:flex;align-items:center;justify-content:flex-end;gap:5rpx;min-width:44px;min-height:44px;padding:0;font-size:22rpx;}
.community-page button.card-like>text{font-size:32rpx;}
.community-page button.card-like .like-count{font-size:22rpx;}
.community-page .text-cover{min-height:280rpx;padding:26rpx 22rpx;border-radius:22rpx;background:#F5EAE1;}
.community-page .text-question{background:#EDF3F7;}
.community-page .text-cover-copy{font-size:30rpx;line-height:1.65;-webkit-line-clamp:6;}
.community-page .text-cover-kicker{font-size:23rpx;margin-bottom:14rpx;}
.community-page .discovery-event{display:flex;align-items:center;min-height:36px;font-size:23rpx;padding:7rpx 10rpx;margin-top:8rpx;}
.search-result{gap:16rpx;font-size:25rpx;line-height:1.5;color:#626973;background:transparent;padding:0 2rpx;margin:-8rpx 0 18rpx;}
.search-result>text:first-child{flex:1;word-break:break-all;}
.community-page button.search-result-clear{display:flex;align-items:center;justify-content:center;min-height:44px;padding:0 8rpx;flex-shrink:0;font-size:25rpx;color:#B64030;}
.feed-load-state{display:flex;align-items:center;justify-content:center;min-height:64px;}
.feed-loading-spinner{width:32rpx;height:32rpx;min-width:16px;min-height:16px;border:3rpx solid #E8DED5;border-top-color:#C47459;border-radius:50%;animation:feed-spin .8s linear infinite;}
@keyframes feed-spin{to{transform:rotate(360deg);}}
.empty-title{font-size:30rpx;font-weight:600;color:#343741;margin:18rpx 0 12rpx;}
.empty .btn{margin-top:18rpx;}
.community-page .empty-continuable{min-height:calc(100vh - 180px);}
.community-filter-layer{position:fixed;inset:0;z-index:70;}
.filter-mask{position:absolute;inset:0;background:rgba(35,31,28,.32);touch-action:none;}
.animal-filter-sheet{position:absolute;left:0;right:0;bottom:0;background:#FAF8F5;border-radius:32rpx 32rpx 0 0;overflow:hidden;}
.sheet-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:26rpx 26rpx 20rpx;}
.sheet-title{font-size:34rpx;font-weight:650;color:#292C32;line-height:1.5;}
.sheet-caption{font-size:26rpx;color:#737981;margin-top:4rpx;}
button.sheet-close{min-width:44px;min-height:44px;font-size:40rpx;line-height:1;color:#81868D;}
.sheet-content{height:56vh;max-height:760rpx;padding:0 26rpx;}
.animal-chips{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:20rpx;}
button.animal-chip{display:flex;align-items:center;justify-content:center;min-height:44px;font-size:26rpx;padding:10rpx 18rpx;border-radius:14rpx;background:#FFFFFF;color:#606872;border:1rpx solid #E9E5E1;margin:0;line-height:1.5;}
button.animal-chip.chosen{background:#FFF0E9;border-color:#E8B6A7;color:#B84735;font-weight:600;}
button.animal-chip.hidden-chosen{background:#EAF2F5;border-color:#A4BDC8;color:#496572;}
.hidden-section{border-top:1rpx solid #E8E3DC;padding:18rpx 0 24rpx;margin-top:24rpx;}
.filter-label{font-size:27rpx;font-weight:600;margin:10rpx 0 18rpx;}
.filter-note{font-size:24rpx;font-weight:400;color:#737981;line-height:1.7;}
.filter-error{font-size:24rpx;color:#986245;line-height:1.7;margin-top:12rpx;}
button.clear-hidden{min-height:44px;font-size:24rpx;color:#617B88;padding:0 8rpx;}
.sheet-footer{padding:16rpx 26rpx calc(22rpx + env(safe-area-inset-bottom));border-top:1rpx solid #E8E3DC;background:#FAF8F5;}
button.sheet-done{display:flex;align-items:center;justify-content:center;width:100%;min-height:44px;background:#CC4A37;color:#FFFFFF;border-radius:16rpx;font-size:28rpx;line-height:1.5;}
@media(max-width:350px){.community-brand{font-size:20px;}.community-page{padding-left:20rpx;padding-right:20rpx;}.feed-tabs{gap:24rpx;}.community-page button.feed-tab{font-size:16px;}.browse-tools{gap:8rpx;}.community-page button.browse-tool{padding:0 10rpx;font-size:12px;}.search-input{font-size:12px;}.community-page .discovery-grid{gap:16rpx;}.community-page .discovery-title{font-size:13px;}.community-page .text-cover-copy{font-size:14px;}.community-page .discovery-label,.community-page .discovery-author .author-name-line,.community-page button.card-like .like-count{font-size:11px;}.media-placeholder{font-size:12px;}}
@media(prefers-reduced-motion:reduce){.community-page .discovery-cover{transition:none;}.feed-loading-spinner{animation:none;}}
.community-page button:focus-visible,.community-filter-layer button:focus-visible{outline:2px solid #CC4A37;outline-offset:2px;}
