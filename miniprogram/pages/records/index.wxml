<view class="page records-page"><view class="page-title">记住喜欢，留住相遇。</view><scroll-view scroll-x="true" class="tabs-scroll"><view class="tabs"><view wx:for="{{tabs}}" wx:key="id" class="pill {{type === item.id ? 'active' : ''}}" bindtap="selectType" data-id="{{item.id}}">{{item.name}}</view></view></scroll-view><view wx:if="{{mode === 'demo'}}" class="demo-label">本机演示 · 记录只保存在当前设备</view><view wx:if="{{loading}}" class="loading">正在整理你的记录…</view><view wx:elif="{{error}}" class="error-box"><text>{{error}}</text><button class="btn btn-secondary" bindtap="refresh">重新加载</button></view><view wx:elif="{{items.length === 0}}" class="empty"><view class="empty-symbol">🌱</view><view class="empty-title">{{nextCursor ? '这一批还没有可见记录' : type === 'bookmarks' ? '收藏一份喜欢的分享' : type === 'following' ? '关注想继续阅读的作者' : '还没有相关记录'}}</view><view class="muted">{{nextCursor ? '可以继续查看后面的记录。' : '从一个话题，或一次轻松的相遇开始。'}}</view><button class="btn btn-primary" bindtap="explore">去发现更多</button></view><block wx:else><view wx:for="{{items}}" wx:key="id" class="record-card card" bindtap="open" data-id="{{item.id}}"><block wx:if="{{type === 'posts' || type === 'bookmarks'}}"><view class="row between"><text class="record-tag">{{item.kindText}} · {{item.circle.name}}</text><text class="small muted">{{item.timeText}}</text></view><view wx:if="{{item.title}}" class="record-post-title">{{item.title}}</view><view class="post-text">{{item.text || '分享了照片'}}</view><image wx:if="{{item.cover}}" class="record-photo" src="{{item.cover}}" mode="aspectFill"/><view wx:if="{{item.topics.length}}" class="record-topic"># {{item.topics[0]}}</view><view class="row between"><view class="record-author" catchtap="openAuthor" data-id="{{item.author.id}}"><image src="{{item.author.avatar}}" mode="aspectFill"/><view class="author-name-stack"><text class="author-name-line">{{item.author.nickname}}</text><view wx:if="{{item.author.petLabel}}" class="pet-byline">{{item.author.petLabel}}</view></view></view><button wx:if="{{type === 'bookmarks'}}" class="remove-bookmark" catchtap="unbookmark" data-id="{{item.id}}" disabled="{{busy}}">★ 取消收藏</button><text wx:else class="small muted">{{item.commentCount}} 个回应</text></view></block><block wx:elif="{{type === 'following'}}"><view class="following-row row"><image class="following-avatar" src="{{item.avatar}}" mode="aspectFill"/><view class="following-info"><view class="record-title">{{item.nickname}}</view><view wx:if="{{item.petLabel}}" class="pet-byline">{{item.petLabel}}</view><view class="small muted">查看主页与分享 ↗</view></view><button class="unfollow-button" catchtap="unfollow" data-id="{{item.id}}" disabled="{{busy}}">已关注</button></view></block><block wx:elif="{{type === 'circles'}}"><view class="circle-row row"><text class="circle-symbol">{{item.icon || '🐾'}}</text><view class="circle-info"><view class="record-title">{{item.name}}</view><view class="small muted">{{item.memberCount}} 位同好 · 已加入</view></view><text class="muted">↗</text></view><view class="circle-description">{{item.description}}</view></block><block wx:else><view class="row between"><text class="record-tag">{{item.petText}}</text><text class="event-status">{{item.statusText}}</text></view><view class="record-title event-title">{{item.title}}</view><view class="event-meta">◷ {{item.timeText}}</view><view class="event-meta">⌖ {{item.location}}</view><view wx:if="{{item.cancelled}}" class="cancel-reason">{{item.cancelReason || '活动已取消'}}</view></block></view></block><button wx:if="{{nextCursor && !loading}}" class="btn btn-ghost" loading="{{moreBusy}}" disabled="{{moreBusy}}" bindtap="loadMore">继续查看记录</button></view>
