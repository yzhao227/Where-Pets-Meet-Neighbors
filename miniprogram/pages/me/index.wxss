.me-navbar{position:sticky;top:0;z-index:30;background:#FAF8F5;}
.me-navbar-row{display:flex;align-items:center;justify-content:center;box-sizing:border-box;}
.me-navbar-title{display:block;min-width:0;font-size:22px;line-height:1.3;font-weight:700;color:#24262D;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.me-page{padding-top:20rpx;}
.me-page .card{border-color:#E9E5E1;}
.me-page .profile-card{padding:28rpx 28rpx 0;}
.me-page .profile-top{display:flex;align-items:center;gap:16rpx;}
.me-page button.profile-identity{display:flex;align-items:center;gap:18rpx;flex:1;min-width:0;text-align:left;}
.me-page .profile-avatar{height:104rpx;width:104rpx;min-width:104rpx;border-radius:50%;border:4rpx solid #FFF0E9;}
.me-page .profile-main{flex:1;min-width:0;}
.me-page .profile-name{font-size:34rpx;font-weight:700;line-height:1.45;overflow-wrap:anywhere;}
.me-page .profile-home{font-size:22rpx;color:#7B818A;margin-top:7rpx;}
.me-page .profile-home text{margin-left:6rpx;}
.me-page button.edit-button{font-size:23rpx;padding:12rpx 18rpx;background:#FFF0E9;color:#B84735;line-height:1.6;border-radius:14rpx;flex-shrink:0;}
.me-page .profile-bio{font-size:26rpx;line-height:1.8;color:#505863;margin-top:22rpx;white-space:pre-wrap;word-break:break-word;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;}
.me-page .profile-location{display:flex;align-items:baseline;gap:12rpx;margin-top:16rpx;font-size:23rpx;color:#6A717B;flex-wrap:wrap;}
.me-page .private-label{font-size:19rpx;color:#7B818A;}
.me-page button.pet-entry{width:100%;display:flex;align-items:center;gap:20rpx;text-align:left;background:#FAF8F5;border:1rpx solid #EEE8E1;border-radius:20rpx;padding:20rpx;margin-top:24rpx;}
.me-page button.has-pet{background:#FFF4EA;border-color:#F0DDCC;padding:24rpx 22rpx;}
.me-page .pet-portrait{display:flex;align-items:center;justify-content:center;width:96rpx;height:96rpx;min-width:96rpx;border-radius:28rpx;background:#FFE7D3;color:#B66C43;font-size:55rpx;}
.me-page .pet-empty .pet-portrait{width:56rpx;height:56rpx;min-width:56rpx;border-radius:17rpx;font-size:30rpx;background:#F0EAE3;}
.me-page .pet-copy{flex:1;min-width:0;}
.me-page .pet-kicker{font-size:21rpx;line-height:1.5;color:#9C755E;}
.me-page .pet-heading{display:flex;align-items:center;flex-wrap:wrap;gap:8rpx 12rpx;margin-top:4rpx;}
.me-page .pet-name{font-size:38rpx;font-weight:700;line-height:1.35;color:#4D3527;word-break:break-word;}
.me-page .pet-type{font-size:21rpx;line-height:1.5;color:#A16E50;border:1rpx solid #EDD4BE;border-radius:8rpx;padding:1rpx 9rpx;}
.me-page .pet-empty-title{font-size:26rpx;font-weight:600;}
.me-page .pet-note{font-size:21rpx;color:#7B818A;margin-top:6rpx;}
.me-page .has-pet .pet-note{color:#9C755E;}
.me-page .stats{display:flex;margin-top:20rpx;border-top:1rpx solid #EEEAE6;}
.me-page button.stat{flex:1;min-width:0;text-align:center;padding:21rpx 5rpx 25rpx;}
.me-page .stat-number{font-size:37rpx;font-weight:700;color:#24262D;line-height:1.4;}
.me-page .stat-label{font-size:23rpx;color:#6A717B;margin-top:4rpx;}
.me-page button.draft-entry{width:100%;display:flex;align-items:center;gap:18rpx;padding:23rpx 26rpx;margin-top:20rpx;text-align:left;background:#FFFFFF;border:1rpx solid #E9E5E1;border-radius:24rpx;}
.me-page button.has-draft{background:#FFF8F3;border-color:#EEDCD0;}
.me-page .draft-icon{display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;min-width:62rpx;border-radius:18rpx;background:#FFF0E9;color:#B84735;font-size:37rpx;}
.me-page .entry-copy{flex:1;min-width:0;}
.me-page .entry-title{font-size:27rpx;font-weight:600;color:#343741;}
.me-page .entry-note{font-size:22rpx;color:#7B818A;line-height:1.7;margin-top:5rpx;word-break:break-word;}
.me-page .entry-arrow{font-size:30rpx;line-height:1;color:#93969C;flex-shrink:0;}
.me-page .draft-preview{white-space:nowrap;text-overflow:ellipsis;overflow:hidden;}
.me-page .draft-badge{display:inline-block;vertical-align:2rpx;font-size:18rpx;font-weight:400;color:#B84735;background:#FCE8DC;border-radius:7rpx;margin-left:10rpx;padding:2rpx 8rpx;}
.me-page .draft-private{font-size:19rpx;color:#986C58;margin-top:5rpx;}
.me-page .participation-card{padding:0 26rpx 25rpx;margin-top:20rpx;}
.me-page button.menu-item{display:flex;width:100%;text-align:left;justify-content:space-between;align-items:center;gap:20rpx;padding:25rpx 0;font-size:26rpx;border-bottom:1rpx solid #EEEAE6;border-radius:0;}
.me-page button.menu-item:last-child{border-bottom:0;}
.me-page .entry-tail{display:flex;align-items:center;gap:14rpx;font-size:22rpx;color:#7B818A;flex-shrink:0;}
.me-page .circle-heading{display:flex;align-items:center;justify-content:space-between;gap:14rpx;padding:22rpx 0 16rpx;}
.me-page .circle-count{font-size:22rpx;font-weight:400;color:#7B818A;margin-left:7rpx;}
.me-page button.text-link{font-size:22rpx;color:#B84735;flex-shrink:0;padding:5rpx 0 5rpx 12rpx;}
.me-page .text-link text{margin-left:6rpx;}
.me-page .circle-empty{font-size:23rpx;line-height:1.8;color:#7B818A;}
.me-page .joined-circles{display:flex;flex-wrap:wrap;gap:10rpx;}
.me-page button.joined-circle{display:flex;align-items:center;gap:10rpx;max-width:100%;padding:12rpx 17rpx;border-radius:12rpx;background:#FAF8F5;font-size:23rpx;text-align:left;}
.me-page .circle-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.me-page .joined-circle .entry-arrow{font-size:24rpx;}
.me-page .group-heading{font-size:23rpx;font-weight:600;color:#7B818A;margin:29rpx 5rpx 13rpx;}
.me-page .menu{padding:0 26rpx;}
.me-page .verification-state{font-size:21rpx;color:#7B818A;}
.me-page .needs-verification{color:#B84735;}
.me-page .policy-links{display:flex;padding:7rpx 0;}
.me-page .policy-links button{flex:1;font-size:22rpx;color:#6A717B;padding:16rpx 8rpx;text-align:center;}
.me-page .policy-links button+button{border-left:1rpx solid #EEEAE6;}
.me-page .admin-card{margin-top:20rpx;padding:0 26rpx;}
.me-page button.admin-heading{display:flex;justify-content:space-between;align-items:center;gap:16rpx;width:100%;text-align:left;padding:25rpx 0;}
.me-page .admin-tag{font-size:19rpx;font-weight:400;color:#7B818A;margin-left:12rpx;}
.me-page .admin-menu{border-top:1rpx solid #EEEAE6;}
.me-page .cleanup-error{margin-top:24rpx;}
.me-page button.delete-link{font-size:23rpx;color:#7B818A;margin:24rpx auto 12rpx;padding:12rpx 20rpx;background:transparent;}
.me-page .local-note{text-align:center;font-size:19rpx;line-height:1.7;color:#7B818A;margin:10rpx 0;}
.me-page .me-footer{text-align:center;color:#8B8E94;font-size:21rpx;letter-spacing:1rpx;margin:24rpx 0 8rpx;}
.me-page .me-footer text{display:block;font-size:20rpx;letter-spacing:0;margin-top:5rpx;}
.my-pet-photo{width:100%;height:100%;border-radius:inherit;}

.me-page .personal-places-card{margin-top:20rpx;}
