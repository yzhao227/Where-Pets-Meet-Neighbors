/* Keep the app's paper/coral palette; the pet card is this page's focal point. */
.me-navbar{position:sticky;top:0;z-index:30;background:var(--paper);}
.me-navbar-row{display:flex;align-items:center;justify-content:center;box-sizing:border-box;}
.me-navbar-title{display:block;min-width:0;font-size:22px;line-height:1.3;font-weight:650;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.me-page{padding-top:20rpx;}
.me-page .card{border-color:var(--line);border-radius:24rpx;}
.me-page .profile-card{padding:4rpx 4rpx 18rpx;}
.me-page .profile-top{display:flex;align-items:center;gap:20rpx;}
.me-page button.profile-identity{display:flex;align-items:center;gap:20rpx;flex:1;min-width:0;min-height:44px;text-align:left;}
.me-page .profile-avatar{height:96rpx;width:96rpx;min-width:96rpx;border-radius:50%;border:4rpx solid #FFFFFF;background:#FFFFFF;}
.me-page .profile-main{flex:1;min-width:0;}
.me-page .profile-name{font-size:36rpx;font-weight:700;line-height:1.4;overflow-wrap:anywhere;}
.me-page .profile-home{font-size:24rpx;color:var(--muted);margin-top:6rpx;}
.me-page .profile-home text{margin-left:6rpx;}
.me-page button.edit-button{display:flex;align-items:center;justify-content:center;min-height:44px;font-size:24rpx;padding:12rpx 16rpx;color:var(--muted);line-height:1.5;flex-shrink:0;}
.me-page .profile-bio{font-size:27rpx;line-height:1.75;color:#505863;margin-top:18rpx;white-space:pre-wrap;word-break:break-word;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;}
.me-page .profile-location{display:flex;align-items:baseline;gap:12rpx;margin-top:12rpx;font-size:24rpx;color:var(--muted);flex-wrap:wrap;}
.me-page .private-label{font-size:22rpx;color:var(--muted);}
.me-page .stats{display:flex;gap:8rpx;margin-top:24rpx;padding:0;background:transparent;border:0;}
.me-page button.stat{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1;min-width:0;min-height:44px;text-align:center;padding:10rpx 6rpx;}
.me-page .stat-number{font-size:36rpx;font-weight:650;color:var(--ink);line-height:1.35;max-width:100%;overflow-wrap:anywhere;}
.me-page .stat-label{font-size:24rpx;color:var(--muted);margin-top:4rpx;line-height:1.5;}
.me-page button.pet-entry{display:flex;align-items:center;gap:26rpx;width:100%;min-height:192rpx;text-align:left;background:var(--accent-soft);border:1rpx solid #F1E0D8;border-radius:26rpx;padding:28rpx;margin:4rpx 0 0;overflow:hidden;}
.me-page .pet-portrait{display:flex;align-items:center;justify-content:center;width:172rpx;height:184rpx;min-width:172rpx;border-radius:18rpx;background:#FAE1D5;overflow:hidden;}
.me-page .my-pet-photo{width:100%;height:100%;border-radius:inherit;}
.me-page .pet-empty .pet-portrait{width:116rpx;height:116rpx;min-width:116rpx;border-radius:50%;background:#FFFFFF;}
.me-page .pet-empty-mark{width:58rpx;height:58rpx;}
.me-page .pet-photo-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;font-size:24rpx;color:#875A4B;}
.me-page .pet-copy{flex:1;min-width:0;}
.me-page .pet-kicker{font-size:24rpx;line-height:1.5;color:#875A4B;}
.me-page .pet-heading{margin-top:8rpx;}
.me-page .pet-name{font-size:40rpx;font-weight:700;line-height:1.35;color:var(--ink);word-break:break-word;}
.me-page .pet-detail{display:flex;align-items:center;flex-wrap:wrap;gap:6rpx 14rpx;font-size:24rpx;line-height:1.5;color:#875A4B;margin-top:10rpx;}
.me-page .pet-empty-title{font-size:32rpx;font-weight:650;line-height:1.4;color:var(--ink);}
.me-page .pet-note{font-size:24rpx;line-height:1.6;color:#875A4B;margin-top:6rpx;}
.me-page .pet-action{display:flex;align-items:center;flex-wrap:wrap;gap:10rpx;min-height:44px;font-size:25rpx;font-weight:600;color:#B84735;margin-top:4rpx;}
.me-page .pet-action>text{font-size:28rpx;font-weight:400;}
.me-page .pet-action .pet-optional{font-size:22rpx;font-weight:400;color:#875A4B;margin-left:4rpx;}
.me-page .record-tools{padding:0;margin-top:24rpx;overflow:hidden;}
.me-page button.draft-entry{display:flex;align-items:center;gap:20rpx;width:100%;padding:24rpx;text-align:left;border-radius:0;background:transparent;}
.me-page button.has-draft{background:#FFF9F4;}
.me-page .draft-icon{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;min-width:72rpx;border-radius:20rpx;background:var(--accent-soft);}
.me-page .draft-icon image{width:38rpx;height:38rpx;}
.me-page .entry-copy{flex:1;min-width:0;}
.me-page .entry-title{font-size:28rpx;font-weight:550;line-height:1.55;color:var(--ink);overflow-wrap:anywhere;}
.me-page .entry-note{font-size:24rpx;color:var(--muted);line-height:1.6;margin-top:5rpx;word-break:break-word;}
.me-page .entry-arrow{font-size:30rpx;line-height:1;color:#92958F;flex-shrink:0;}
.me-page .draft-preview{white-space:nowrap;text-overflow:ellipsis;overflow:hidden;}
.me-page .draft-badge{display:inline-block;vertical-align:2rpx;font-size:21rpx;font-weight:400;color:#B84735;background:#FCE8DC;border-radius:7rpx;margin-left:10rpx;padding:2rpx 8rpx;}
.me-page .draft-private{font-size:22rpx;color:#875A4B;margin-top:5rpx;}
.me-page .quick-links{display:flex;align-items:stretch;margin:0 24rpx;padding:24rpx 0;border-top:1rpx solid #EEEAE6;}
.me-page button.quick-entry{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;flex:1;min-width:0;min-height:44px;gap:7rpx;padding:4rpx 8rpx;text-align:center;border-radius:14rpx;}
.me-page .quick-icon{width:44rpx;height:44rpx;margin-bottom:5rpx;}
.me-page .quick-title{font-size:25rpx;font-weight:500;color:var(--ink);line-height:1.5;}
.me-page .quick-note{font-size:22rpx;color:var(--muted);line-height:1.5;overflow-wrap:anywhere;}
.me-page button.personal-place-entry{display:flex;align-items:center;gap:20rpx;width:100%;padding:24rpx;text-align:left;border-top:1rpx solid #EEEAE6;}
.me-page .personal-place-icon{width:40rpx;height:40rpx;margin:0 16rpx;flex-shrink:0;}
.me-page .group-heading{font-size:25rpx;font-weight:500;color:var(--muted);margin:32rpx 6rpx 12rpx;}
.me-page .menu{padding:0 24rpx;}
.me-page button.menu-item{display:flex;align-items:center;justify-content:space-between;gap:20rpx;width:100%;min-height:44px;text-align:left;padding:24rpx 0;font-size:28rpx;border-bottom:1rpx solid #EEEAE6;border-radius:0;}
.me-page button.menu-item:last-child{border-bottom:0;}
.me-page .entry-tail{display:flex;align-items:center;gap:12rpx;max-width:38%;font-size:24rpx;color:var(--muted);flex-shrink:0;}
.me-page .verification-state{font-size:24rpx;color:var(--muted);}
.me-page .needs-verification{color:#B84735;}
.me-page .policy-links{display:flex;padding:6rpx 0;}
.me-page .policy-links button{display:flex;align-items:center;justify-content:center;flex:1;min-width:0;min-height:44px;font-size:24rpx;color:var(--muted);padding:16rpx 8rpx;text-align:center;}
.me-page .policy-links button+button{border-left:1rpx solid #EEEAE6;}
.me-page .admin-card{margin-top:24rpx;padding:0 24rpx;}
.me-page button.admin-heading{display:flex;justify-content:space-between;align-items:center;gap:16rpx;width:100%;min-height:44px;text-align:left;padding:24rpx 0;}
.me-page .admin-tag{font-size:22rpx;font-weight:400;color:var(--muted);margin-left:12rpx;}
.me-page .admin-menu{border-top:1rpx solid #EEEAE6;}
.me-page .cleanup-error{margin-top:24rpx;}
.me-page button.delete-link{min-height:44px;font-size:24rpx;color:var(--muted);margin:24rpx auto 12rpx;padding:12rpx 20rpx;background:transparent;}
.me-page button.me-pressed{background:#F5F2EE;}
.me-page button:focus-visible{outline:2px solid #B84735;outline-offset:2px;}
