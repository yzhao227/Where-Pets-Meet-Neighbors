<view class="me-navbar" style="padding-top:{{statusBarHeight}}px;">
  <view class="me-navbar-row" style="height:{{navigationHeight}}px;padding-left:{{navigationInset}}px;padding-right:{{navigationInset}}px;"><text class="me-navbar-title">我的小天地</text></view>
</view>
<view class="page me-page">
  <view wx:if="{{loading}}" class="loading">正在整理你的小天地…</view>
  <view wx:elif="{{error}}" class="error-box">
    <text>{{error}}</text>
    <button wx:if="{{errorCode === 'ACCOUNT_UNAVAILABLE'}}" class="btn btn-secondary" bindtap="deleteAccount" loading="{{busy}}" disabled="{{busy}}">继续清除我的资料</button>
    <button wx:else class="btn btn-secondary" bindtap="refresh">重新加载</button>
  </view>
  <block wx:else>
    <view class="profile-card">
      <view class="profile-top">
        <button class="profile-identity" bindtap="publicProfile" aria-label="{{personalMode ? '编辑我的私人资料' : '查看我的个人主页'}}">
          <image class="profile-avatar" aria-hidden="true" src="{{user.avatar || '/assets/avatar-1.png'}}" mode="aspectFill"/>
          <view class="profile-main">
            <view class="profile-name">{{user.nickname}}</view>
            <view class="profile-home">{{personalMode ? '我的私人资料' : '查看个人主页'}} <text>›</text></view>
          </view>
        </button>
        <button class="edit-button" bindtap="editProfile">编辑资料</button>
      </view>
      <view wx:if="{{user.bio}}" class="profile-bio">{{user.bio}}</view>
      <view wx:if="{{user.area}}" class="profile-location"><text>{{user.area}}</text><text class="private-label">仅自己可见</text></view>
      <view class="stats">
        <button class="stat" bindtap="records" data-type="posts"><view class="stat-number">{{stats.postCount || 0}}</view><view class="stat-label">{{personalMode ? '私人记录' : '我的分享'}}</view></button>
        <button class="stat" bindtap="records" data-type="bookmarks"><view class="stat-number">{{stats.bookmarkCount || 0}}</view><view class="stat-label">我的收藏</view></button>
        <button wx:if="{{!personalMode}}" class="stat" bindtap="records" data-type="following"><view class="stat-number">{{stats.followingCount || 0}}</view><view class="stat-label">我的关注</view></button>
        <button wx:if="{{personalMode}}" class="stat" bindtap="editProfile"><view class="stat-number">{{user.pets.length || 0}}</view><view class="stat-label">动物伙伴</view></button>
      </view>
    </view>

    <button class="pet-entry {{user.pet ? 'has-pet' : 'pet-empty'}}" bindtap="editProfile" aria-label="{{user.pet ? '查看与编辑宠物资料，' + user.pet.name + '，' + petLabel : '添加宠物资料，选填'}}">
      <view class="pet-portrait" aria-hidden="true">
        <image wx:if="{{user.pets[0].photo}}" class="my-pet-photo" src="{{user.pets[0].photo}}" mode="aspectFill"/>
        <view wx:else class="pet-photo-placeholder"><image class="pet-empty-mark" src="/assets/tab-community-active.png" mode="aspectFit"/><text wx:if="{{user.pet}}">暂无照片</text></view>
      </view>
      <view class="pet-copy">
        <view wx:if="{{user.pet}}" class="pet-kicker">我的宠物{{user.pets.length > 1 ? ' · ' + user.pets.length + ' 只' : ''}}</view>
        <block wx:if="{{user.pet}}">
          <view class="pet-heading"><text class="pet-name">{{user.pet.name}}</text></view>
          <view class="pet-detail"><text class="pet-type">{{petLabel}}</text><text wx:if="{{user.pets[0].ageLabel}}">{{user.pets[0].ageLabel}}</text></view>
          <view class="pet-action">查看宠物档案 <text>›</text></view>
        </block>
        <block wx:else>
          <view class="pet-empty-title">我的宠物</view>
          <view class="pet-note">保存照片、名字与成长资料</view>
          <view class="pet-action">添加宠物 <text>＋</text><text class="pet-optional">选填</text></view>
        </block>
      </view>
    </button>



    <view class="record-tools card">
      <button class="draft-entry {{hasDraft ? 'has-draft' : ''}}" bindtap="openDraft" hover-class="me-pressed" aria-label="{{draftError ? '草稿箱，本机草稿暂时无法读取' : hasDraft ? '草稿箱，查看当前账号的本机草稿' : '草稿箱，记录新的日常'}}">
        <view class="draft-icon" aria-hidden="true"><image src="/assets/me/draft.svg" mode="aspectFit"/></view>
        <view class="entry-copy">
          <view class="entry-title">{{personalMode ? '随手记' : '草稿箱'}} <text wx:if="{{hasDraft}}" class="draft-badge">待完成</text></view>
          <view class="entry-note {{draftError ? 'draft-error-note' : 'draft-preview'}}">{{draftError || (hasDraft ? draftPreview : '留住萌宠的新鲜事')}}</view>
          <view wx:if="{{hasDraft && !draftError}}" class="draft-private">仅保存在当前设备</view>
        </view>
        <text class="entry-arrow" aria-hidden="true">›</text>
      </button>
      <view wx:if="{{!personalMode}}" class="quick-links">
        <button class="quick-entry" bindtap="myPlaces" hover-class="me-pressed">
          <image class="quick-icon" src="/assets/me/place.svg" mode="aspectFit" aria-hidden="true"/>
          <text class="quick-title">我的地点</text><text class="quick-note">收藏与到访</text>
        </button>
        <button class="quick-entry" bindtap="records" data-type="events" hover-class="me-pressed">
          <image class="quick-icon" src="/assets/me/calendar.svg" mode="aspectFit" aria-hidden="true"/>
          <text class="quick-title">活动报名</text><text class="quick-note">{{stats.joinedEventCount || 0}} 个报名</text>
        </button>
        <button class="quick-entry" bindtap="exploreCircles" hover-class="me-pressed">
          <image class="quick-icon" src="/assets/me/guide.svg" mode="aspectFit" aria-hidden="true"/>
          <text class="quick-title">主题指南</text><text class="quick-note">按主题浏览</text>
        </button>
      </view>
      <button wx:else class="personal-place-entry" bindtap="myPlaces" hover-class="me-pressed">
        <image class="personal-place-icon" src="/assets/me/place.svg" mode="aspectFit" aria-hidden="true"/>
        <view class="entry-copy"><view class="entry-title">我的地点</view><view class="entry-note">收藏想去的，记下去过的</view></view>
        <text class="entry-arrow" aria-hidden="true">›</text>
      </button>
    </view>

    <view class="group-heading">账号与隐私</view>
    <view class="menu card">
      <button class="menu-item" bindtap="editProfile">
        <view class="entry-copy"><view class="entry-title">{{personalMode ? '资料与宠物档案' : '资料与公开范围'}}</view><view class="entry-note">{{privacySummary}}</view></view>
        <text class="entry-arrow" aria-hidden="true">›</text>
      </button>
      <button wx:if="{{!personalMode}}" class="menu-item" bindtap="registerIdentity">
        <view class="entry-copy"><view class="entry-title">手机号核验</view><view class="entry-note">{{verificationStatus === 'unverified' ? '核验后可发布和参与互动' : verificationStatus === 'demo_verified' ? '演示标记，不代表真实手机号核验' : maskedPhone || '核验信息仅自己可见'}}</view></view>
        <view class="entry-tail"><text class="verification-state {{verificationStatus === 'unverified' ? 'needs-verification' : ''}}">{{verificationStatus === 'unverified' ? '去核验' : verificationStatus === 'demo_verified' ? '模拟核验' : '已核验'}}</text><text class="entry-arrow" aria-hidden="true">›</text></view>
      </button>
      <button wx:if="{{!personalMode}}" class="menu-item" bindtap="blocked"><text class="entry-title">已屏蔽用户</text><text class="entry-arrow" aria-hidden="true">›</text></button>
      <button wx:if="{{!personalMode}}" class="menu-item private-library-entry" bindtap="privateLibrary"><view class="entry-copy"><view class="entry-title">本机私人资料</view><view class="entry-note">原个人版的日记、宠物与草稿</view></view><text class="entry-arrow" aria-hidden="true">›</text></button>
    </view>

    <view class="group-heading">帮助与说明</view>
    <view class="menu card help-card">
      <button class="menu-item" bindtap="help"><text class="entry-title">反馈与帮助</text><text class="entry-arrow" aria-hidden="true">›</text></button>
      <view class="policy-links"><button bindtap="terms">用户协议</button><button bindtap="privacy">资料与隐私说明</button></view>
    </view>

    <view wx:if="{{!personalMode && user.isAdmin}}" class="admin-card card">
      <button class="admin-heading" bindtap="toggleAdmin" aria-expanded="{{adminExpanded}}"><view class="entry-title">管理工具 <text class="admin-tag">仅管理员可见</text></view><text class="entry-arrow" aria-hidden="true">{{adminExpanded ? '⌃' : '⌄'}}</text></button>
      <view wx:if="{{adminExpanded}}" class="admin-menu">
        <button class="menu-item" bindtap="manage"><text>活动管理</text><text class="entry-arrow" aria-hidden="true">›</text></button>
        <button class="menu-item" bindtap="managePlaces"><text>地点管理</text><text class="entry-arrow" aria-hidden="true">›</text></button>
        <button class="menu-item" bindtap="reviewSubmissions"><text>投稿审核</text><text class="entry-arrow" aria-hidden="true">›</text></button>
        <button class="menu-item" bindtap="moderation"><text>举报处理</text><text class="entry-arrow" aria-hidden="true">›</text></button>
        <button class="menu-item" bindtap="petStats"><text>宠物登记概况</text><text class="entry-arrow" aria-hidden="true">›</text></button>
        <button class="menu-item" bindtap="operations"><text>服务运行概况</text><text class="entry-arrow" aria-hidden="true">›</text></button>
      </view>
    </view>
    <view wx:if="{{localCleanupPending}}" class="error-box cleanup-error">个人资料和内容已清除，本机草稿、照片或参照地点还未清理成功。<button class="btn btn-secondary" bindtap="clearLocalDrafts" disabled="{{busy}}">重试清理本机记录</button></view>
    <button class="delete-link" disabled="{{busy}}" bindtap="deleteAccount">清除我的资料和内容</button>
  </block>
</view>
