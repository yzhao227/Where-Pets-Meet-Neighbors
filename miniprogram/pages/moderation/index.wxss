.moderation-page>.eyebrow{margin-top:15rpx;}
.page-title{font-size:42rpx;margin:4rpx 0 18rpx;}
.subtitle{font-size:25rpx;line-height:1.8;margin-bottom:24rpx;}
.filter-track{display:flex;gap:15rpx;margin:25rpx 0;}
.report-card{padding:26rpx;margin-bottom:24rpx;}
.report-type{font-size:21rpx;color:#505863;}
.status-tag{font-size:20rpx;border-radius:10rpx;padding:6rpx 12rpx;background:#F4F0EB;color:#505863;}
.status-open{background:#FFF3E6;color:#94603D;}
.status-resolved{background:#EAF2F8;color:#516B80;}
.report-reason{font-size:30rpx;font-weight:650;line-height:1.6;margin:18rpx 0;}
.report-description{font-size:25rpx;line-height:1.8;white-space:pre-wrap;color:#505863;margin-bottom:20rpx;}
.target-summary{border-radius:17rpx;padding:20rpx;background:#FAF9F7;border:1rpx solid #E9E5E1;}
.summary-label{font-size:20rpx;color:#66707A;margin-bottom:8rpx;}
.summary-text{font-size:25rpx;color:#505863;line-height:1.85;white-space:pre-wrap;overflow-wrap:anywhere;}
.reporter{gap:13rpx;margin:22rpx 0;}
.reporter-avatar{width:51rpx;height:51rpx;border-radius:50%;}
.reporter-detail{font-size:22rpx;color:#505863;}
.reporter-detail .small{font-size:19rpx;margin-top:2rpx;}
.report-actions{padding-top:18rpx;border-top:1rpx solid #E9E5E1;gap:14rpx;}
button.source-button{margin:0;padding:0;color:#B84735;background:transparent;font-size:23rpx;line-height:1.8;}
button.handle-button{margin:0;padding:10rpx 18rpx;font-size:22rpx;line-height:1.7;border-radius:15rpx;background:#FFF0E9;color:#B84735;}
.report-actions .small{font-size:21rpx;}
.resolution-form{border-top:1rpx solid #E9E5E1;margin-top:22rpx;padding-top:24rpx;}
.resolution-form .label{font-size:24rpx;}
.optional{font-size:19rpx;color:#66707A;font-weight:400;margin-left:10rpx;}
.note-input{font-size:25rpx;line-height:1.8;height:170rpx;min-height:170rpx;}
.resolution-buttons{display:flex;gap:14rpx;margin-top:20rpx;}
.resolution-buttons .btn{flex:1;font-size:24rpx;min-height:75rpx;padding:17rpx 10rpx;border-radius:18rpx;}
.moderation-note{font-size:21rpx;color:#66707A;text-align:center;line-height:1.9;margin:27rpx 0;}
.empty-symbol{font-size:60rpx;color:#EF725B;}
.empty-title{font-size:29rpx;font-weight:650;margin:21rpx 0 15rpx;}
