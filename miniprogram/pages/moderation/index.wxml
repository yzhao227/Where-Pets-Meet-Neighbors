<view class="page moderation-page">
  
  <view class="page-title">认真对待每个反馈。</view>
  <view class="subtitle">核查内容、完成必要处置，再记录处理结果。</view>
  <view wx:if="{{loading}}" class="loading">正在整理举报记录…</view>
  <view wx:elif="{{error}}" class="error-box"><text>{{error}}</text><button class="btn btn-secondary" bindtap="refresh">重新加载</button></view>
  <view wx:elif="{{!isAdmin}}" class="empty"><view class="empty-title">这是运营者的工作台</view><view class="muted">只有获得管理员权限的账号，才能查看和处理举报。</view></view>
  <block wx:else>
    <view wx:if="{{mode === 'demo'}}" class="demo-label">本机演示 · 举报与处理结果只保存在当前设备</view>
    <view class="filter-track">
      <view class="pill {{status === 'open' ? 'active' : ''}}" bindtap="selectStatus" data-status="open">待处理</view>
      <view class="pill {{status === 'all' ? 'active' : ''}}" bindtap="selectStatus" data-status="all">全部记录</view>
    </view>
    <view wx:if="{{items.length === 0}}" class="empty"><view class="empty-symbol">🌿</view><view class="empty-title">{{status === 'open' ? '暂时没有待处理举报' : '还没有举报记录'}}</view><view class="muted">用户提交的问题会显示在这里。</view></view>
    <view wx:for="{{items}}" wx:key="id" class="report-card card">
      <view class="row between"><text class="report-type">{{item.typeText}}</text><text class="status-tag status-{{item.status}}">{{item.statusText}}</text></view>
      <view class="report-reason">{{item.reason}}</view>
      <view wx:if="{{item.description}}" class="report-description">{{item.description}}</view>
      <view class="target-summary"><view class="summary-label">被举报内容</view><view class="summary-text">{{item.targetSummary || '暂无内容摘要'}}</view></view>
      <view class="reporter row"><image class="reporter-avatar" src="{{item.reporter.avatar || '/assets/avatar-1.png'}}" mode="aspectFill"/><view class="reporter-detail"><view>{{item.reporter.nickname}}</view><view class="small muted">{{item.timeText}} 提交</view></view></view>
      <view class="report-actions row between">
        <button wx:if="{{item.canOpen}}" class="source-button" bindtap="openTarget" data-id="{{item.id}}">查看原内容 ↗</button>
        <text wx:else class="small muted">请根据内容摘要核查</text>
        <button wx:if="{{item.status === 'open'}}" class="handle-button" bindtap="expand" data-id="{{item.id}}" disabled="{{busy}}">{{selectedId === item.id ? '收起处理' : '记录处理结果'}}</button>
      </view>
      <view wx:if="{{item.status === 'open' && selectedId === item.id}}" class="resolution-form">
        <view class="label">处理说明 <text class="optional">选填 · 将通知举报者</text></view>
        <textarea class="textarea note-input" value="{{notes[item.id] || ''}}" bindinput="inputNote" data-id="{{item.id}}" maxlength="300" placeholder="简要说明核查情况及处理结果…" disabled="{{busy}}"/>
        <view class="resolution-buttons"><button class="btn btn-secondary" bindtap="resolve" data-id="{{item.id}}" data-status="dismissed" disabled="{{busy}}">无需处理</button><button class="btn btn-primary" bindtap="resolve" data-id="{{item.id}}" data-status="resolved" loading="{{busy}}" disabled="{{busy}}">标记已处理</button></view>
      </view>
    </view>
    <button wx:if="{{nextCursor}}" class="btn btn-ghost" bindtap="loadMore" loading="{{moreBusy}}" disabled="{{moreBusy}}">查看更多记录</button>
    <view class="moderation-note">举报记录仅管理员可见。核查时请保护提交者隐私。</view>
  </block>
</view>
