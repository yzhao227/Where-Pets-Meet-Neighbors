page{background:#181B20;color:#F4F3F1;}.video-page{min-height:100vh;padding:0 0 calc(30rpx + env(safe-area-inset-bottom));box-sizing:border-box;}.player-frame{position:relative;min-height:62vh;background:#101216;}.player-frame video{display:block;width:100%;height:70vh;}.player-message{min-height:62vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24rpx;padding:30rpx;box-sizing:border-box;font-size:26rpx;color:#DADCE0;text-align:center;}.player-message button{min-width:220rpx;margin:0;padding:18rpx 30rpx;border-radius:16rpx;background:#F7F3EE;color:#34373B;font-size:26rpx;}.player-caption{padding:30rpx;}.player-title{font-size:30rpx;line-height:1.6;font-weight:600;}.player-author{font-size:23rpx;color:#B6BCC5;margin-top:14rpx;}.player-buffer{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;}.player-spinner{width:36rpx;height:36rpx;border:3rpx solid rgba(255,255,255,.2);border-top-color:#fff;border-radius:50%;animation:player-spin .8s linear infinite;}@keyframes player-spin{to{transform:rotate(360deg);}}
