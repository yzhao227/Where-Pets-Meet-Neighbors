/* 有宠有邻 · warm paper, ink typography and restrained coral accents. */
page{--ink:#24262D;--green:#BB4937;--accent:#EF725B;--accent-strong:#CC4A37;--accent-soft:#FFF0E9;--paper:#FAF8F5;--muted:#6A717B;--line:#E9E5E1;background:var(--paper);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.65;box-sizing:border-box;}
view,text,button,input,textarea,scroll-view,picker{box-sizing:border-box;}
/* Match the v2 native button selector: compact controls must never inherit 184px. */
button,button:not([size="mini"]){width:auto;min-width:0;font:inherit;color:inherit;padding:0;margin:0;border-radius:0;background:transparent;line-height:inherit;}
button::after{border:0;}
button[disabled]{opacity:.48;}
image{display:block;}
.page{padding:24rpx 30rpx 48rpx;}
.eyebrow{color:var(--muted);font-size:18rpx;font-weight:500;letter-spacing:1rpx;}
.page>.eyebrow{display:none;}
.page-title{font-size:42rpx;font-weight:700;line-height:1.4;letter-spacing:-.8rpx;}
.subtitle{font-size:25rpx;color:var(--muted);margin-top:10rpx;line-height:1.7;}
.section-title{font-size:31rpx;font-weight:650;letter-spacing:-.3rpx;}
.row{display:flex;align-items:center;gap:16rpx;}
.between{display:flex;align-items:center;justify-content:space-between;gap:16rpx;}
.muted{color:var(--muted);}
.small{font-size:23rpx;}
.card{background:#FFFFFF;border:1rpx solid var(--line);border-radius:24rpx;padding:26rpx;}
.pill{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;padding:13rpx 24rpx;background:#FFFFFF;border:1rpx solid var(--line);border-radius:18rpx;color:#626973;font-size:25rpx;line-height:1.4;}
.pill.active{color:#B84735;background:var(--accent-soft);border-color:#F0B7A8;font-weight:600;}
button.btn{display:flex;align-items:center;justify-content:center;gap:12rpx;min-height:88rpx;padding:20rpx 30rpx;border-radius:20rpx;font-size:28rpx;font-weight:600;line-height:1.5;}
button.btn-primary{background:var(--accent-strong);color:#FFFFFF;}
button.btn-secondary{background:var(--accent-soft);color:#B84735;}
button.btn-ghost{background:transparent;color:#B84735;}
.avatar{width:72rpx;height:72rpx;border-radius:50%;background:#F4F0EB;flex-shrink:0;}
.divider{height:1rpx;background:var(--line);margin:26rpx 0;}
.empty{padding:64rpx 24rpx;text-align:center;color:var(--muted);line-height:1.9;}
.field{margin-bottom:28rpx;}
.label{font-size:26rpx;font-weight:600;display:block;margin-bottom:12rpx;}
.input,.textarea{width:100%;background:#FAF9F7;border:1rpx solid var(--line);border-radius:16rpx;padding:22rpx 24rpx;font-size:28rpx;color:var(--ink);line-height:1.65;}
.input{height:92rpx;}
.textarea{min-height:220rpx;height:280rpx;}
.loading{padding:50rpx 20rpx;text-align:center;color:var(--muted);}
.error-box{padding:24rpx;background:#FFF3E6;color:#94603D;border:1rpx solid #F0DDC7;border-radius:20rpx;margin-bottom:24rpx;}
.demo-label{display:inline-block;padding:6rpx 12rpx;border-radius:8rpx;background:#EAF2F8;color:#516B80;font-size:19rpx;line-height:1.5;}
.safe-bottom{padding-bottom:calc(44rpx + env(safe-area-inset-bottom));}
.author-name-stack{flex:1;min-width:0;line-height:1.5;}
.author-name-line{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.pet-byline{font-size:20rpx;line-height:1.5;font-weight:400;color:#737B85;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:3rpx;}
.author-meta,.post-author{min-width:0;}
.comment-name{overflow-wrap:break-word;}
.record-author{flex:1;}
.record-author image{flex-shrink:0;}
.remove-bookmark{flex-shrink:0;}
.discovery-author .pet-byline{font-size:18rpx;color:#767E88;margin-top:1rpx;}
.discovery-author .author-name-line{font-size:21rpx;}
/* Two-column discovery cards let the picture or short question lead. */
.discovery-grid{display:flex;flex-wrap:wrap;align-items:flex-start;gap:18rpx 14rpx;}
.discovery-card{width:calc((100% - 14rpx)/2);background:#FFFFFF;border:1rpx solid #EDE9E5;border-radius:20rpx;overflow:hidden;min-width:0;}
.discovery-cover-wrap{position:relative;height:310rpx;background:#F4F0EB;}
.discovery-cover{width:100%;height:100%;}
.photo-count{position:absolute;top:12rpx;right:12rpx;background:rgba(36,38,45,.58);color:#FFFFFF;font-size:18rpx;border-radius:12rpx;padding:3rpx 10rpx;}
.cover-kind{position:absolute;bottom:12rpx;left:12rpx;background:rgba(255,255,255,.95);color:#505863;font-size:19rpx;padding:4rpx 11rpx;border-radius:9rpx;}
.text-cover{padding:24rpx 22rpx;background:#FFF0E9;min-height:284rpx;}
.text-question{background:#EAF2F8;}
.text-meetup{background:#FFF3E6;}
.text-cover-kicker{font-size:20rpx;line-height:1.7;color:#7A6660;margin-bottom:18rpx;}
.text-question .text-cover-kicker{color:#58738A;}
.text-cover-kicker text{font-size:27rpx;font-weight:700;margin-right:5rpx;color:#BB4937;}
.text-cover-copy{font-size:28rpx;line-height:1.75;font-weight:600;color:#343741;white-space:pre-wrap;display:-webkit-box;-webkit-line-clamp:6;-webkit-box-orient:vertical;overflow:hidden;word-break:break-word;}
.discovery-body{padding:17rpx 18rpx 18rpx;}
.discovery-title{font-size:27rpx;font-weight:650;line-height:1.55;color:#24262D;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;white-space:pre-wrap;word-break:break-word;}
.discovery-topic{font-size:21rpx;color:#B84735;margin-top:10rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.discovery-event{font-size:20rpx;color:#94603D;background:#FFF3E6;border-radius:10rpx;padding:6rpx 9rpx;margin-top:12rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.discovery-footer{display:flex;align-items:center;gap:8rpx;margin-top:17rpx;}
.discovery-author{display:flex;gap:9rpx;align-items:center;flex:1;min-width:0;}
.discovery-author image{width:40rpx;height:40rpx;min-width:40rpx;border-radius:50%;background:#F4F0EB;}
.discovery-author text{font-size:21rpx;color:#626973;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
button.card-like{margin:0;padding:5rpx 0 5rpx 5rpx;display:flex;align-items:center;gap:4rpx;font-size:20rpx;line-height:1.4;background:transparent;color:#7B818A;flex-shrink:0;}
button.card-like text{font-size:29rpx;line-height:1;}
button.card-like.liked{color:#CC4A37;}
.discovery-meta{font-size:18rpx;color:#7B818A;margin-top:11rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
/* Published reading material keeps its origin visible without competing with the story. */
.source-badge{display:inline-block;font-size:19rpx;line-height:1.5;padding:4rpx 9rpx;border-radius:8rpx;background:#EAF2F8;color:#516B80;}
.source-note{margin-top:24rpx;padding:20rpx;border:1rpx solid #DCE7F0;border-radius:16rpx;background:#F2F7FB;}
.source-label{font-size:23rpx;font-weight:600;line-height:1.6;color:#3F5B71;}
.source-text{font-size:22rpx;line-height:1.8;color:#627687;margin-top:8rpx;word-break:break-word;}
button.source-link{font-size:23rpx;line-height:1.8;padding:10rpx 0 0;color:#B84735;background:transparent;text-align:left;}
/* Real empty states are calm, illustrated invitations rather than sample activity. */
.empty-art{width:320rpx;height:214rpx;max-width:100%;display:block;margin:0 auto 14rpx;}
.community-page .empty,.nearby-page .empty,.messages-page .empty{padding:36rpx 28rpx 32rpx;background:#FFFFFF;border:1rpx solid #E9E5E1;border-radius:24rpx;font-size:25rpx;}
.community-page .empty .muted,.nearby-page .empty .muted,.messages-page .empty .muted{font-size:24rpx;line-height:1.8;max-width:540rpx;margin:0 auto;}
.community-page .empty .btn{margin:22rpx auto 0;width:100%;max-width:440rpx;}
.discovery-body .source-badge{max-width:100%;margin-top:10rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
